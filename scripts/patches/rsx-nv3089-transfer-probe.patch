+static int gcm_probe_begin(cellGcmTransferProbe* event, u32 src, u32 dst,
+        u32 w, u32 h, u32 sp, u32 dp)
+{
+    static const char* gate;
+    static int initialized, maximum;
+    static u32 count;
+    if (!initialized) {
+        gate = getenv("NV3089_PROBE_GATE");
+        const char* cap = getenv("NV3089_PROBE_MAX");
+        maximum = cap ? atoi(cap) : 8;
+        if (maximum < 1 || maximum > 64) maximum = 8;
+        initialized = 1;
+    }
+    if (!gate || !*gate || count >= (u32)maximum) return 0;
+    /* Deliberately observe only the verified linear ARGB 1:1, zero-origin
+     * path. Scaled, swizzled and clipped transfers need different samples. */
+    if ((s_nv3089.fmt & 0xFF) != 3 || s_nv309e.active ||
+            s_nv3089.ds_dx != 0x100000 || s_nv3089.dt_dy != 0x100000 ||
+            s_nv3089.in_uv || s_nv3089.out_pt || s_nv3089.clip_pt ||
+            ((s_nv3089.clip_sz & 0xFFFF) && (s_nv3089.clip_sz & 0xFFFF) < w) ||
+            ((s_nv3089.clip_sz >> 16) && (s_nv3089.clip_sz >> 16) < h) ||
+            (u64)w * 4 > sp || (u64)w * 4 > dp) return 0;
+    FILE* ready = fopen(gate, "rb");
+    if (!ready) return 0;
+    fclose(ready);
+    event->id = count++;
+    event->source_ea = src; event->destination_ea = dst;
+    event->source_offset = s_nv3089.in_off;
+    event->destination_offset = s_gcm2d.dst_offset;
+    event->source_location = s_nv3089.src_dma == 0xFEED0001u ? 2u : 1u;
+    event->destination_location = s_gcm2d.dst_dma == 0xFEED0001u ? 2u : 1u;
+    event->width = w; event->height = h;
+    event->source_pitch = sp; event->destination_pitch = dp;
+    if (s_transfer_probe_observer) s_transfer_probe_observer(event);
+    return 1;
 }
 
