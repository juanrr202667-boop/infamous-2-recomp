+/* Metadata only: never submit, wait, map, write guest bytes or mutate replay.
+ * A declared producer does not prove rasterized pixels. Completed view epochs
+ * belong to earlier submissions when the relevant operations remain pending. */
+static void d3d12_transfer_probe(const cellGcmTransferProbe* event)
+{
+    u32 declared = 0, last = UINT32_MAX, views = 0;
+    u64 newest = 0;
+    for (u32 i = 0; i < s_d3d.draw_count && i < MAX_DRAWS; ++i) {
+        const D3D12DrawRecord* draw = &s_d3d.draws[i];
+        const rsx_d3d12_surface_metadata* meta = &draw->surface_meta;
+        const int members = rsx_declared_surface_target_count(meta);
+        if (!meta->valid || (draw->is_clear ? !(meta->clear_flags & 0xF0u) : !draw->cmask)) continue;
+        for (int n = 0; n < members; ++n) {
+            const u32 member = n ? (u32)n : (meta->color_target == 2 ? 1u : 0u);
+            if (!(meta->dma_seen & (1u << member))) continue;
+            const u32 dma = meta->color_dma[member];
+            if (dma != 0xFEED0000u && dma != 0xFEED0001u) continue;
+            const u32 location = dma == 0xFEED0001u ? 2u : 1u;
+            if (cellGcmTransferProbeFits(event, location, meta->color_offset[member],
+                    meta->color_pitch[member], draw->rt_w, draw->rt_h)) {
+                ++declared; last = i;
+                break;
+            }
+        }
+    }
+    for (u32 i = 0; i < s_off_rt_count && i < MAX_OFF_RTS; ++i) {
+        const rsx_linear_version* view = &s_off_rt_views[i];
+        if (!s_d3d.off_rt[i].res || view->view.offset > UINT32_MAX ||
+                !cellGcmTransferProbeFits(event, view->view.location, (u32)view->view.offset,
+                    view->view.pitch, view->view.width, view->view.height)) continue;
+        ++views;
+        if (view->complete_at > newest) newest = view->complete_at;
+    }
+    const rsx_state* state = s_d3d.current_rsx_state;
+    printf("[NV3089GPU] id=%u frame=%llu pending_ops=%u declared_color_ops=%u last_color_op=%u "
+           "completed_views=%u newest_epoch=%llu committed_epoch=%llu replay_pending=%d "
+           "src=%u:%08X/%u current_zeta=%08X/%u zeta_dma=%08X surface_format=%08X metadata_only=1\n",
+           event->id, (unsigned long long)s_d3d.frame_count, s_d3d.draw_count, declared, last,
+           views, (unsigned long long)newest, (unsigned long long)s_off_rt_epoch, s_temporal_pending,
+           event->source_location, event->source_offset, event->source_pitch,
+           state ? state->surface_zeta_offset : 0, state ? state->surface_zeta_pitch : 0,
+           state ? state->surface_zeta_dma : 0, state ? state->surface_format : 0);
+}
