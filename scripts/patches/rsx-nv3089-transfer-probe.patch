+typedef struct GcmProbeSample {
+    u32 first, last, hash, valid, nonzero;
+} GcmProbeSample;
+
+/* Sixteen sparse BE words at a 4x4 grid, excluding row padding. This is an
+ * observation, not a checksum of the complete surface or a freshness proof. */
+static GcmProbeSample gcm_probe_sample(u32 ea, u32 pitch, u32 w, u32 h)
+{
+    GcmProbeSample result = {0, 0, 2166136261u, 0, 0};
+    const u64 limit = ppu_vm_size ? ppu_vm_size : 0x100000000ULL;
+    if (!vm_base || !w || !h) return result;
+    for (u32 y = 0; y < 4; ++y) {
+        for (u32 x = 0; x < 4; ++x) {
+            const u32 index = y * 4 + x;
+            const u64 at = (u64)ea + ((u64)(h - 1) * y / 3) * pitch +
+                           ((u64)(w - 1) * x / 3) * 4;
+            u8 bytes[4];
+            if (at + 4 > limit) continue;
+#ifdef _WIN32
+            SIZE_T copied = 0;
+            if (!ReadProcessMemory(GetCurrentProcess(), vm_base + at, bytes, 4, &copied) || copied != 4)
+                continue;
+#else
+            memcpy(bytes, vm_base + at, 4);
+#endif
+            const u32 word = ((u32)bytes[0] << 24) | ((u32)bytes[1] << 16) |
+                             ((u32)bytes[2] << 8) | bytes[3];
+            result.valid |= 1u << index;
+            if (!index) result.first = word;
+            if (index == 15) result.last = word;
+            if (word) ++result.nonzero;
+            for (u32 b = 0; b < 4; ++b) result.hash = (result.hash ^ bytes[b]) * 16777619u;
+        }
+    }
+    return result;
+}
