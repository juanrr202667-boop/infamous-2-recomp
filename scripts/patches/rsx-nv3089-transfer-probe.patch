+/* Optional same-thread, read-only observation before a linear NV3089 copy.
+ * Locations use the explicit probe convention: 1 LOCAL, 2 MAIN. Registration
+ * belongs to backend initialization/shutdown, before/after FIFO processing. */
+typedef struct cellGcmTransferProbe {
+    u32 id, source_ea, destination_ea;
+    u32 source_offset, destination_offset;
+    u32 source_location, destination_location;
+    u32 width, height, source_pitch, destination_pitch;
+} cellGcmTransferProbe;
+typedef void (*cellGcmTransferProbeObserver)(const cellGcmTransferProbe*);
+void cellGcmSetTransferProbeObserver(cellGcmTransferProbeObserver observer);
+
+/* Shared metadata association; this does not assert GPU content validity. */
+static inline int cellGcmTransferProbeFits(const cellGcmTransferProbe* event,
+        u32 location, u32 offset, u32 pitch, u32 width, u32 height)
+{
+    if (!event || !pitch || !width || !height || !event->width || !event->height ||
+            location != event->source_location || pitch != event->source_pitch ||
+            event->source_offset < offset || (u64)width * 4 > pitch ||
+            (u64)offset + (u64)(height - 1) * pitch + (u64)width * 4 > 0x100000000ULL)
+        return 0;
+    const u32 delta = event->source_offset - offset;
+    const u32 row = delta / pitch, byte_x = delta % pitch;
+    if ((byte_x & 3u) || row >= height || (u64)byte_x >= (u64)width * 4) return 0;
+    return (u64)byte_x + (u64)event->width * 4 <= (u64)width * 4 &&
+        event->height <= height - row;
+}
 
