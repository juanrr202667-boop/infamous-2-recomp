+/* The lifter wraps only the two BCUS98125 direct callsites. Slots contain
+ * atomically published (nesting depth, original callsite); the observer never
+ * dereferences a guest context. The wrapper returns before trampoline drain. */
+struct I2LightCallObserver {
+    std::atomic<uint64_t> slots[64]{};
+    std::atomic<uint64_t> entered[64]{}, returned[64]{};
+    std::atomic<uint64_t> site_entered[64][2]{}, site_returned[64][2]{};
+    unsigned delay, interval, maximum;
+    static DWORD WINAPI run(LPVOID arg) {
+        I2LightCallObserver* s = static_cast<I2LightCallObserver*>(arg);
+        Sleep(s->delay);
+        for (unsigned n = 0; n < s->maximum; ++n) {
+            for (unsigned t = 0; t < 64; ++t) {
+                const uint64_t in = s->entered[t].load(std::memory_order_acquire);
+                if (!in) continue;
+                const uint64_t v = s->slots[t].load(std::memory_order_acquire);
+                const uint64_t out = s->returned[t].load(std::memory_order_acquire);
+                if (v) fprintf(stderr, "[i2-light-call] tid=%u active=%08X depth=%u entered=%llu returned=%llu", t,
+                    (unsigned)v, (unsigned)(v >> 32), (unsigned long long)in, (unsigned long long)out);
+                else fprintf(stderr, "[i2-light-call] tid=%u idle entered=%llu returned=%llu", t,
+                    (unsigned long long)in, (unsigned long long)out);
+                fprintf(stderr, " enter718=%llu return718=%llu enter97C=%llu return97C=%llu\n",
+                    (unsigned long long)s->site_entered[t][0].load(std::memory_order_acquire),
+                    (unsigned long long)s->site_returned[t][0].load(std::memory_order_acquire),
+                    (unsigned long long)s->site_entered[t][1].load(std::memory_order_acquire),
+                    (unsigned long long)s->site_returned[t][1].load(std::memory_order_acquire));
+            }
+            fflush(stderr); Sleep(s->interval);
+        }
+        return 0;
+    }
+};
+static I2LightCallObserver* i2_light_call_observer() {
+    static I2LightCallObserver* s = []() -> I2LightCallObserver* {
+        const char* v = getenv("I2_LIGHT_CALL_AFTER_MS"); char* end = nullptr;
+        if (!v || !*v) return nullptr;
+        unsigned long delay = strtoul(v, &end, 10);
+        if (*end || !delay || delay > 3600000) return nullptr;
+        unsigned long interval = 1000, maximum = 60;
+        v = getenv("I2_LIGHT_CALL_INTERVAL_MS");
+        if (v && *v) { interval = strtoul(v, &end, 10); if (*end || !interval || interval > 60000) return nullptr; }
+        v = getenv("I2_LIGHT_CALL_MAX");
+        if (v && *v) { maximum = strtoul(v, &end, 10); if (*end || !maximum || maximum > 10000) return nullptr; }
+        auto* p = new I2LightCallObserver{};
+        p->delay = (unsigned)delay; p->interval = (unsigned)interval; p->maximum = (unsigned)maximum;
+        HANDLE h = CreateThread(nullptr, 0, I2LightCallObserver::run, p, 0, nullptr);
+        if (!h) { delete p; return nullptr; } CloseHandle(h); return p;
+    }();
+    return s;
+}
+extern "C" void i2_light_callsite_trace(ppu_context* ctx, unsigned phase, unsigned site) {
+    I2LightCallObserver* s = i2_light_call_observer();
+    if (!s || !ctx || ctx->thread_id >= 64 || (site != 0x001DB718 && site != 0x001DB97C)) return;
+    struct Frame { uint64_t previous; unsigned tid, site; };
+    static thread_local Frame stack[64]; static thread_local unsigned depth = 0;
+    const unsigned tid = (unsigned)ctx->thread_id;
+    const unsigned site_index = site == 0x001DB718 ? 0 : 1;
+    if (!phase) {
+        if (depth >= 64) { ++depth; return; }
+        stack[depth] = {s->slots[tid].load(std::memory_order_acquire), tid, site};
+        ++depth;
+        s->slots[tid].store(((uint64_t)depth << 32) | site, std::memory_order_release);
+        s->entered[tid].fetch_add(1, std::memory_order_release);
+        s->site_entered[tid][site_index].fetch_add(1, std::memory_order_release);
+    } else if (depth) {
+        if (depth > 64) { --depth; return; }
+        Frame f = stack[--depth];
+        if (f.tid != tid || f.site != site) return;
+        s->slots[tid].store(f.previous, std::memory_order_release);
+        s->returned[tid].fetch_add(1, std::memory_order_release);
+        s->site_returned[tid][site_index].fetch_add(1, std::memory_order_release);
+    }
+}
