+static void write_capture_fragment_state(FILE* out, u32 ndraws)
+{
+    const char* enabled = getenv("RSX_CAP_FP_STATE");
+    if (!out || !enabled || strcmp(enabled, "1")) return;
+    fprintf(out, "--- fp state (completed display draws) ---\n");
+    if (!s_d3d.vp_fpcb_mapped) {
+        fprintf(out, "fragment constant bank unavailable\n");
+        return;
+    }
+    const u32 par = (u32)(s_d3d.vp_parity ^ 1);
+    for (u32 d = 0; d < ndraws && d < MAX_DRAWS; ++d) {
+        const D3D12DrawRecord* r = &s_d3d.draws[d];
+        if (r->is_clear || !r->fp_addr || !s_rt_plan[d].display_target) continue;
+        const float* bank = (const float*)((const char*)s_d3d.vp_fpcb_mapped
+            + ((u64)par * MAX_DRAWS + d) * VP_FPCB_STRIDE);
+        fprintf(out, "op%03u fp=%08X exp32=%d hash=%08X hash_valid=%u parity=%u record_hash=%08X\n",
+                d, r->fp_addr, r->fp_exp32, s_temporal_fp_hash[d],
+                (unsigned)s_temporal_fp_hash_valid[d], par, s_recorded_fp_hash[d]);
+        fprintf(out, "  record_prefix=");
+        for (u32 b = 0; b < 32; ++b) fprintf(out, "%02X", (unsigned)s_recorded_fp_prefix[d][b]);
+        fprintf(out, "\n");
+        for (u32 k = 0; k < RSX_D3D12_FP_CONSTANT_COUNT; ++k) {
+            const float* v = bank + RSX_D3D12_FP_CONSTANT_FLOAT_OFFSET + k * 4;
+            fprintf(out, "  k[%u] = %.9g %.9g %.9g %.9g\n", k,
+                    (double)v[0], (double)v[1], (double)v[2], (double)v[3]);
+        }
+    }
+}
