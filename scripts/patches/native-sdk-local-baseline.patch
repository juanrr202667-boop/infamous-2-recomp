+#ifndef RSX_LINEAR_COHERENCE_H
+#define RSX_LINEAR_COHERENCE_H
+
+#include "rsx_linear_view.h"
+
+typedef struct rsx_linear_version {
+    rsx_linear_view view;
+    /* Every pixel is current through this epoch. Promoting a partial write
+     * requires first reconciling the complete view, including retained lanes. */
+    uint64_t complete_at;
+} rsx_linear_version;
+
+typedef int (*rsx_linear_version_emit)(void* user, uint32_t src, uint32_t dst,
+                                     const rsx_linear_copy_span* span);
+
+typedef struct rsx_linear_version_relay {
+    rsx_linear_version_emit emit;
+    void* user;
+    uint32_t src, dst;
+} rsx_linear_version_relay;
+
+static inline int rsx_linear_version_emit_span(void* user, const rsx_linear_copy_span* span)
+{
+    rsx_linear_version_relay* relay = (rsx_linear_version_relay*)user;
+    return relay->emit(relay->user, relay->src, relay->dst, span);
+}
+
+/* Plan all newer intersecting snapshots in chronological order. Choosing only
+ * the newest view loses other regions. Including older snapshots can restore
+ * stale pixels. The caller retains every producer and commits complete_at only
+ * after accepting the entire plan; this function never mutates the catalog.
+ *
+ * Indices identify stable resource instances; the caller owns retention and
+ * fences. This is not an eviction algorithm or a classifier of RSX layouts. */
+static inline int rsx_linear_plan_materialize(const rsx_linear_version* views,
+        uint32_t count, uint32_t dst, uint64_t epoch,
+        rsx_linear_version_emit emit, void* user)
+{
+    if (!views || !emit || dst >= count) return RSX_LINEAR_BAD_VIEW;
+    for (uint32_t i = 0; i < count; ++i)
+        if (!rsx_linear_view_valid(&views[i].view) || views[i].complete_at > epoch)
+            return RSX_LINEAR_BAD_VIEW;
+
+    uint64_t after = views[dst].complete_at;
+    uint32_t previous = UINT32_MAX;
+    for (;;) {
+        uint32_t next = UINT32_MAX;
+        for (uint32_t i = 0; i < count; ++i) {
+            uint64_t at = views[i].complete_at;
+            if (i == dst || at <= views[dst].complete_at || at < after ||
+                    (at == after && (previous == UINT32_MAX || i <= previous))) continue;
+            if (next == UINT32_MAX || at < views[next].complete_at ||
+                    (at == views[next].complete_at && i < next)) next = i;
+        }
+        if (next == UINT32_MAX) return RSX_LINEAR_OK;
+        rsx_linear_version_relay relay = {emit, user, next, dst};
+        int result = rsx_linear_foreach_overlap(&views[next].view, &views[dst].view,
+                                               rsx_linear_version_emit_span, &relay);
+        if (result != RSX_LINEAR_OK) return result;
+        after = views[next].complete_at;
+        previous = next;
+    }
+}
+
+#endif
