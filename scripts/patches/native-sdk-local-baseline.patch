+#ifndef RSX_D3D12_TEMPORAL_PLAN_H
+#define RSX_D3D12_TEMPORAL_PLAN_H
+
+#include "rsx_linear_metadata.h"
+#include "rsx_linear_catalog.h"
+
+/* Included after the backend record, catalog and off_rt_get_view declarations.
+ * These plans carry resource identities only. The caller owns content epochs,
+ * resource creation, copies, barriers and submission. Discard a failed plan. */
+static struct {
+    int target[4];
+    u32 texture_mask;
+} s_rt_plan[MAX_DRAWS];
+static const char* s_temporal_error;
+static u32 s_temporal_error_op;
+static int s_temporal_error_unit;
+
+static int temporal_plan_fail(const char* message, u32 op, int unit)
+{
+    s_temporal_error = message;
+    s_temporal_error_op = op;
+    s_temporal_error_unit = unit;
+    return 0;
+}
+
+static int temporal_mark_overlap(void* user, const rsx_linear_copy_span* span)
+{
+    (void)span;
+    *(int*)user = 1;
+    return 1;
+}
+
+/* INCOMPATIBLE is returned only for a real byte intersection. Such an alias
+ * must also be rejected for simultaneous reads/writes or MRT destinations. */
+static int temporal_byte_overlap(const rsx_linear_view* a, const rsx_linear_view* b)
+{
+    int overlap = 0;
+    int result = rsx_linear_foreach_overlap(a, b, temporal_mark_overlap, &overlap);
+    if (result == RSX_LINEAR_INCOMPATIBLE) return 1;
+    return result == RSX_LINEAR_OK ? overlap : -1;
+}
+
+static int temporal_prepare_targets(void)
+{
+    u32 op;
+    s_temporal_error = NULL;
+    s_temporal_error_op = 0;
+    s_temporal_error_unit = -1;
+    for (op = 0; op < MAX_DRAWS; ++op) {
+        int member;
+        for (member = 0; member < 4; ++member) s_rt_plan[op].target[member] = -1;
+        s_rt_plan[op].texture_mask = 0;
+    }
+    if (s_d3d.draw_count > MAX_DRAWS)
+        return temporal_plan_fail("draw count exceeds temporal plan capacity", 0, -1);
+    for (op = 0; op < s_d3d.draw_count; ++op) {
+        int unit;
+        for (unit = 0; unit < 16; ++unit) s_d3d.draws[op].tex_rt[unit] = -1;
+    }
+    if (s_off_rt_count > MAX_OFF_RTS)
+        return temporal_plan_fail("invalid render-target catalog count", 0, -1);
+
+    for (op = 0; op < s_d3d.draw_count; ++op) {
+        const D3D12DrawRecord* dr = &s_d3d.draws[op];
+        int member;
+        if (dr->is_clear) {
+            u32 color_flags = dr->surface_meta.clear_flags & 0xF0u;
+            if (!color_flags) continue;
+            if (color_flags != 0xF0u)
+                return temporal_plan_fail("partial color clear is unsupported", op, -1);
+        }
+        for (member = 0; member < 4; ++member) {
+            u32 raw = member ? dr->rt_mrt[member - 1] : dr->rt_off;
+            u32 declared_member = member ? (u32)member :
+                (dr->surface_meta.color_target == 2 ? 1u : 0u);
+            rsx_linear_view view;
+            int slot;
+            if (!raw) continue;
+            if (rsx_declared_surface_linear(&dr->surface_meta, dr->rt_fmt,
+                    declared_member, &view) != RSX_LINEAR_META_OK)
+                return temporal_plan_fail("unsupported or missing render-target metadata", op, -1);
+            if (view.offset != raw)
+                return temporal_plan_fail("render-target offset differs from declared surface", op, -1);
+            slot = off_rt_get_view(&view);
+            if (slot < 0 || (u32)slot >= s_off_rt_count || (u32)slot >= MAX_OFF_RTS)
+                return temporal_plan_fail("render-target view reservation failed", op, -1);
+            s_rt_plan[op].target[member] = slot;
+        }
+        for (member = 0; member < 4; ++member) {
+            int other;
+            int a = s_rt_plan[op].target[member];
+            if (a < 0) continue;
+            for (other = member + 1; other < 4; ++other) {
+                int b = s_rt_plan[op].target[other];
+                int overlap;
+                if (b < 0) continue;
+                overlap = temporal_byte_overlap(&s_off_rt_views[a].view, &s_off_rt_views[b].view);
+                if (overlap < 0)
+                    return temporal_plan_fail("invalid MRT view geometry", op, -1);
+                if (overlap)
+                    return temporal_plan_fail("overlapping MRT destination alias is unsupported", op, -1);
+            }
+        }
+    }
+    return 1;
+}
+
+static int temporal_prepare_textures(u32 draw, u32 mask)
+{
+    D3D12DrawRecord* dr;
+    int unit;
+    s_temporal_error = NULL;
+    s_temporal_error_op = draw;
+    s_temporal_error_unit = -1;
+    if (draw >= s_d3d.draw_count || draw >= MAX_DRAWS)
+        return temporal_plan_fail("texture plan draw index is out of range", draw, -1);
+    dr = &s_d3d.draws[draw];
+    for (unit = 0; unit < 16; ++unit) dr->tex_rt[unit] = -1;
+    s_rt_plan[draw].texture_mask = mask;
+    if (mask & ~0xFFFFu)
