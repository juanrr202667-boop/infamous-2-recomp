+/**
+ * gpu_tlsf_allocator.h
+ * Constant-time O(1) GPU suballocator for preallocated 2 GB D3D12 heaps.
+ * Based on technical specification AG-D3D12-PLACED-HEAPS.
+ */
+
+#ifndef GPU_TLSF_ALLOCATOR_H
+#define GPU_TLSF_ALLOCATOR_H
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <string.h>
+#include <assert.h>
+
+#if defined(_MSC_VER) && !defined(__clang__)
+#include <intrin.h>
+#pragma intrinsic(_BitScanForward)
+#pragma intrinsic(_BitScanReverse64)
+#endif
+
+#define GPU_TLSF_ALIGN_64K    (64ULL * 1024ULL)          /* 65,536 bytes (standard textures/buffers) */
+#define GPU_TLSF_ALIGN_4M     (4ULL * 1024ULL * 1024ULL)    /* 4,194,304 bytes (MSAA/render targets) */
+#define GPU_TLSF_MIN_BLOCK_SZ GPU_TLSF_ALIGN_64K
+#define GPU_TLSF_FLI_OFFSET   16                         /* Starts at 2^16 = 64 KiB */
+#define GPU_TLSF_FLI_COUNT    16                         /* From 2^16 to 2^31 (2 GiB) */
+#define GPU_TLSF_SLI_COUNT    32                         /* 32 linear subdivisions per level */
+
+typedef struct GpuTlsfBlock {
+    uint64_t offset;                   /* Byte offset in ID3D12Heap */
+    uint64_t size;                     /* Block size in bytes */
+    bool     is_free;                  /* Block state */
+    struct GpuTlsfBlock* prev_phys;    /* Previous physically adjacent block */
+    struct GpuTlsfBlock* next_phys;    /* Next physically adjacent block */
+    struct GpuTlsfBlock* prev_free;    /* Doubly linked free list */
+    struct GpuTlsfBlock* next_free;
+} GpuTlsfBlock;
+
+typedef struct GpuTlsfPool {
+    uint64_t total_size;
+    uint64_t allocated_size;
+    uint32_t fl_bitmap;
+    uint32_t sl_bitmap[GPU_TLSF_FLI_COUNT];
+    GpuTlsfBlock* matrix[GPU_TLSF_FLI_COUNT][GPU_TLSF_SLI_COUNT];
+    GpuTlsfBlock* block_pool_nodes;   /* Static node pool avoids CPU mallocs */
+    uint32_t node_count;
+    uint32_t node_capacity;
+} GpuTlsfPool;
+
+static inline int gpu_tlsf_ffs32(uint32_t word)
+{
+#if defined(_MSC_VER)
+    unsigned long index;
+    if (_BitScanForward(&index, word)) {
+        return (int)index;
+    }
+    return -1;
+#else
+    return word ? __builtin_ctz(word) : -1;
+#endif
+}
+
+static inline int gpu_tlsf_fls64(uint64_t word)
+{
+#if defined(_MSC_VER)
+    unsigned long index;
+    if (_BitScanReverse64(&index, word)) {
+        return (int)index;
+    }
+    return -1;
+#else
+    return word ? (63 - __builtin_clzll(word)) : -1;
+#endif
+}
+
+/* Resolve the first-level index (FLI) and second-level index (SLI). */
+static inline void gpu_tlsf_mapping(uint64_t size, int* fli, int* sli)
+{
+    if (size < GPU_TLSF_MIN_BLOCK_SZ) size = GPU_TLSF_MIN_BLOCK_SZ;
+
+    int r = gpu_tlsf_fls64(size);
+    if (r < 0) r = 0;
+
+    int fl = r;
+    int sl = (int)((size ^ (1ULL << fl)) >> ((fl >= 5) ? (fl - 5) : 0));
+    fl -= GPU_TLSF_FLI_OFFSET;
+    if (fl < 0) { fl = 0; sl = 0; }
+    if (fl >= GPU_TLSF_FLI_COUNT) { fl = GPU_TLSF_FLI_COUNT - 1; sl = GPU_TLSF_SLI_COUNT - 1; }
+
+    *fli = fl;
+    *sli = sl;
+}
+
+static inline void gpu_tlsf_insert_free(GpuTlsfPool* pool, GpuTlsfBlock* block)
+{
+    int fl, sl;
+    gpu_tlsf_mapping(block->size, &fl, &sl);
+
+    block->is_free = true;
+    block->prev_free = NULL;
+    block->next_free = pool->matrix[fl][sl];
+
+    if (pool->matrix[fl][sl]) {
+        pool->matrix[fl][sl]->prev_free = block;
+    }
+    pool->matrix[fl][sl] = block;
+
+    pool->fl_bitmap |= (1u << fl);
+    pool->sl_bitmap[fl] |= (1u << sl);
+}
+
+static inline void gpu_tlsf_remove_free(GpuTlsfPool* pool, GpuTlsfBlock* block)
+{
+    int fl, sl;
+    gpu_tlsf_mapping(block->size, &fl, &sl);
+
+    if (block->prev_free) {
+        block->prev_free->next_free = block->next_free;
+    } else {
+        pool->matrix[fl][sl] = block->next_free;
+    }
+
+    if (block->next_free) {
+        block->next_free->prev_free = block->prev_free;
+    }
+
+    if (!pool->matrix[fl][sl]) {
+        pool->sl_bitmap[fl] &= ~(1u << sl);
+        if (!pool->sl_bitmap[fl]) {
+            pool->fl_bitmap &= ~(1u << fl);
+        }
+    }
+    block->is_free = false;
+}
+
+/* Initialize the pool at maximum capacity */
+static inline void gpu_tlsf_init(GpuTlsfPool* pool, uint64_t total_size, GpuTlsfBlock* node_storage, uint32_t max_nodes)
+{
+    memset(pool, 0, sizeof(GpuTlsfPool));
+    pool->total_size = total_size;
+    pool->block_pool_nodes = node_storage;
+    pool->node_capacity = max_nodes;
+    pool->node_count = 1;
+
+    /* Create the initial contiguous block covering the entire heap */
+    GpuTlsfBlock* root = &pool->block_pool_nodes[0];
+    root->offset = 0;
+    root->size = total_size;
+    root->is_free = true;
+    root->prev_phys = NULL;
+    root->next_phys = NULL;
+
+    gpu_tlsf_insert_free(pool, root);
+}
+
+/* Constant-time O(1) allocation with strict alignment */
+static inline uint64_t gpu_tlsf_allocate(GpuTlsfPool* pool, uint64_t size, uint64_t alignment)
+{
+    if (alignment < GPU_TLSF_ALIGN_64K) alignment = GPU_TLSF_ALIGN_64K;
+    uint64_t aligned_request = size + alignment;
+    int fl, sl;
+    gpu_tlsf_mapping(aligned_request, &fl, &sl);
+
+    /* 1. Search the second-level mask */
+    uint32_t sl_map = pool->sl_bitmap[fl] & (~0u << sl);
+    int found_fl = fl;
+    int found_sl = -1;
+
+    if (sl_map) {
+        found_sl = gpu_tlsf_ffs32(sl_map);
+    } else {
+        /* 2. Search the first-level mask */
+        uint32_t fl_map = pool->fl_bitmap & (~0u << (fl + 1));
+        if (!fl_map) return UINT64_MAX; /* Heap memory exhausted */
+
+        found_fl = gpu_tlsf_ffs32(fl_map);
+        if (found_fl < 0 || found_fl >= GPU_TLSF_FLI_COUNT) return UINT64_MAX;
+
+        found_sl = gpu_tlsf_ffs32(pool->sl_bitmap[found_fl]);
+        if (found_sl < 0 || found_sl >= GPU_TLSF_SLI_COUNT) return UINT64_MAX;
+    }
+
+    GpuTlsfBlock* block = pool->matrix[found_fl][found_sl];
+    if (!block || !block->is_free) return UINT64_MAX;
+    gpu_tlsf_remove_free(pool, block);
+
+    /* Calculate the aligned offset. */
+    uint64_t aligned_offset = (block->offset + (alignment - 1)) & ~(alignment - 1);
+    uint64_t padding = aligned_offset - block->offset;
+
+    /* If front padding remains, create a preceding free block. */
+    if (padding >= GPU_TLSF_MIN_BLOCK_SZ && pool->node_count < pool->node_capacity) {
+        GpuTlsfBlock* front_pad = &pool->block_pool_nodes[pool->node_count++];
+        front_pad->offset = block->offset;
+        front_pad->size = padding;
+        front_pad->prev_phys = block->prev_phys;
+        front_pad->next_phys = block;
+        if (block->prev_phys) block->prev_phys->next_phys = front_pad;
+        block->prev_phys = front_pad;
+        block->offset = aligned_offset;
+        block->size -= padding;
+        gpu_tlsf_insert_free(pool, front_pad);
+    }
+
+    /* Split the block if enough tail space remains (O(1)). */
+    uint64_t remaining = block->size - size;
+    if (remaining >= GPU_TLSF_MIN_BLOCK_SZ && pool->node_count < pool->node_capacity) {
+        GpuTlsfBlock* split_tail = &pool->block_pool_nodes[pool->node_count++];
+        split_tail->offset = block->offset + size;
+        split_tail->size = remaining;
+        split_tail->prev_phys = block;
+        split_tail->next_phys = block->next_phys;
+        if (block->next_phys) block->next_phys->prev_phys = split_tail;
+        block->next_phys = split_tail;
+        block->size = size;
+        gpu_tlsf_insert_free(pool, split_tail);
+    }
+
+    pool->allocated_size += block->size;
+    return block->offset;
+}
+
+/* Free and immediately coalesce in both directions (O(1)). */
+static inline void gpu_tlsf_free(GpuTlsfPool* pool, uint64_t offset)
+{
+    GpuTlsfBlock* block = NULL;
+    for (uint32_t i = 0; i < pool->node_count; ++i) {
+        if (pool->block_pool_nodes[i].offset == offset && !pool->block_pool_nodes[i].is_free) {
+            block = &pool->block_pool_nodes[i];
+            break;
+        }
+    }
+    if (!block) return;
+
+    pool->allocated_size -= block->size;
+
+    /* Merge with the next physical neighbor */
+    if (block->next_phys && block->next_phys->is_free) {
+        GpuTlsfBlock* next = block->next_phys;
+        gpu_tlsf_remove_free(pool, next);
+        block->size += next->size;
+        block->next_phys = next->next_phys;
+        if (next->next_phys) next->next_phys->prev_phys = block;
+    }
+
+    /* Merge with the previous physical neighbor */
+    if (block->prev_phys && block->prev_phys->is_free) {
+        GpuTlsfBlock* prev = block->prev_phys;
+        gpu_tlsf_remove_free(pool, prev);
+        prev->size += block->size;
+        prev->next_phys = block->next_phys;
+        if (block->next_phys) block->next_phys->prev_phys = prev;
+        block = prev;
+    }
+
+    gpu_tlsf_insert_free(pool, block);
+}
+
+#endif /* GPU_TLSF_ALLOCATOR_H */
