+#ifndef RSX_LINEAR_CATALOG_H
+#define RSX_LINEAR_CATALOG_H
+
+#include "rsx_linear_coherence.h"
+
+enum { RSX_LINEAR_CATALOG_FULL = -4 };
+
+/* Reserve a stable index in the caller-owned contiguous catalog [0, count).
+ * Hits preserve content epochs. New entries start at epoch zero; the caller
+ * still owns seeding, content validity, GPU resources and lifetime. No entry
+ * is evicted and no output changes on failure. count and slot must differ. */
+static inline int rsx_linear_reserve_view(rsx_linear_version* views,
+        uint32_t capacity, uint32_t* count, const rsx_linear_view* view,
+        uint32_t* slot)
+{
+    if (!views || !count || !view || !slot || count == slot)
+        return RSX_LINEAR_BAD_VIEW;
+    const uint32_t n = *count;
+    if (n > capacity || !rsx_linear_view_valid(view))
+        return RSX_LINEAR_BAD_VIEW;
+
+    for (uint32_t i = 0; i < n; ++i) {
+        const rsx_linear_view* existing = &views[i].view;
+        if (existing->offset == view->offset && existing->width == view->width &&
+                existing->height == view->height && existing->pitch == view->pitch &&
+                existing->bytes_per_pixel == view->bytes_per_pixel &&
+                existing->format_id == view->format_id && existing->location == view->location) {
+            *slot = i;
+            return RSX_LINEAR_OK;
+        }
+    }
+    if (n == capacity) return RSX_LINEAR_CATALOG_FULL;
+
+    views[n].view = *view;
+    views[n].complete_at = 0;
+    *count = n + 1u;
+    *slot = n;
+    return RSX_LINEAR_OK;
+}
+
+#endif
