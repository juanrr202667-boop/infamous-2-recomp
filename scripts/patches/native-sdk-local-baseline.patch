+#ifndef RSX_D3D12_SHADER_RESOURCES_H
+#define RSX_D3D12_SHADER_RESOURCES_H
+
+/* COM C interface, including when compiled as C++. No device is required. */
+#include <d3dcompiler.h>
+#include <d3d11shader.h>
+#include "ps3emu/ps3types.h"
+
+/* The compiled shader's declared texture ranges, after compiler optimization.
+ * This is conservative for arrays and conditional references, not a record of
+ * dynamic reads. UINT32_MAX means unknown: callers must never treat it as zero.
+ */
+static u32 rsx_d3d12_shader_texture_mask(ID3DBlob* shader)
+{
+    /* Match IID_ID3D11ShaderReflection without a dxguid library dependency.
+     * REFIID is a reference in C++ and a pointer in C. */
+    static const GUID reflection_iid = {
+        0x8d536ca1, 0x0cca, 0x4956,
+        {0xa8, 0x37, 0x78, 0x69, 0x63, 0x75, 0x55, 0x84}
+    };
+    ID3D11ShaderReflection* reflection = NULL;
+    D3D11_SHADER_DESC shader_desc;
+    const void* data;
+    SIZE_T size;
+    HRESULT hr;
+    u32 mask = 0;
+    UINT i;
+
+    if (!shader) return UINT32_MAX;
+    data = shader->lpVtbl->GetBufferPointer(shader);
+    size = shader->lpVtbl->GetBufferSize(shader);
+    if (!data || !size) return UINT32_MAX;
+#ifdef __cplusplus
+    hr = D3DReflect(data, size, reflection_iid, (void**)&reflection);
+#else
+    hr = D3DReflect(data, size, &reflection_iid, (void**)&reflection);
+#endif
+    if (FAILED(hr) || !reflection) return UINT32_MAX;
+    hr = reflection->lpVtbl->GetDesc(reflection, &shader_desc);
+    if (FAILED(hr)) {
+        reflection->lpVtbl->Release(reflection);
+        return UINT32_MAX;
+    }
+    for (i = 0; i < shader_desc.BoundResources; ++i) {
+        D3D11_SHADER_INPUT_BIND_DESC resource;
+        UINT slot;
+        hr = reflection->lpVtbl->GetResourceBindingDesc(reflection, i, &resource);
+        if (FAILED(hr)) {
+            mask = UINT32_MAX;
+            break;
+        }
+        if (resource.Type != D3D_SIT_TEXTURE) continue;
+        if (!resource.BindCount || resource.BindPoint >= 16 ||
+            resource.BindCount > 16 - resource.BindPoint) {
+            mask = UINT32_MAX;
+            break;
+        }
+        for (slot = 0; slot < resource.BindCount; ++slot)
+            mask |= 1u << (resource.BindPoint + slot);
+    }
+    reflection->lpVtbl->Release(reflection);
+    return mask;
+}
+
+#endif
