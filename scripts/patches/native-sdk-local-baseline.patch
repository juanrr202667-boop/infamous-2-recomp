+#ifndef RSX_D3D12_LINEAR_TARGETS_H
+#define RSX_D3D12_LINEAR_TARGETS_H
+
+#include <stdint.h>
+#include <string.h>
+#include "rsx_linear_catalog.h"
+
+/* Backend lexical adapter: OffRT, s_d3d, s_off_rt_views/count, MAX_OFF_RTS,
+ * RT_SRV_BASE and C COM D3D12 declarations must already be available.
+ * The caller keeps guest mappings stable while seeding and retains all target
+ * resources, descriptors and upload buffers until their last GPU fence.
+ * A hit never reloads guest bytes or changes the complete-content epoch. */
+
+static int off_rt_seed_readable(const uint8_t* pointer, uint64_t bytes)
+{
+    uintptr_t cursor = (uintptr_t)pointer;
+    if (!bytes || bytes > UINTPTR_MAX - cursor) return 0;
+    const uintptr_t end = cursor + (uintptr_t)bytes;
+    while (cursor < end) {
+        MEMORY_BASIC_INFORMATION info;
+        if (VirtualQuery((const void*)cursor, &info, sizeof(info)) != sizeof(info) ||
+                info.State != MEM_COMMIT || (info.Protect & (PAGE_GUARD | PAGE_NOACCESS)))
+            return 0;
+        switch (info.Protect & 0xFFu) {
+        case PAGE_READONLY: case PAGE_READWRITE: case PAGE_WRITECOPY:
+        case PAGE_EXECUTE_READ: case PAGE_EXECUTE_READWRITE: case PAGE_EXECUTE_WRITECOPY:
+            break;
+        default: return 0;
+        }
+        const uintptr_t base = (uintptr_t)info.BaseAddress;
+        if (base > cursor || !info.RegionSize || info.RegionSize > UINTPTR_MAX - base)
+            return 0;
+        const uintptr_t region_end = base + info.RegionSize;
+        if (region_end <= cursor) return 0;
+        cursor = region_end < end ? region_end : end;
+    }
+    return 1;
+}
+
+static int off_rt_get_view(const rsx_linear_view* view)
+{
+    extern uint8_t* vm_base;
+    extern u32 cellGcmResolveLocated(int local, u32 offset);
+    extern u32 cellGcmResolveIO(u32 offset);
+    if (!view || !rsx_linear_view_valid(view) || view->format_id != 0x85 ||
+            view->bytes_per_pixel != 4 || view->width > 16384 || view->height > 16384 ||
+            !s_d3d.device || !s_d3d.cmd_list || !s_d3d.rt_rtv_heap ||
+            !s_d3d.srv_heap || !s_d3d.srv_inc || s_off_rt_count > MAX_OFF_RTS)
+        return -1;
+
+    const uint64_t row_bytes = (uint64_t)view->width * 4;
+    const uint64_t span = (uint64_t)(view->height - 1) * view->pitch + row_bytes;
+    if (view->offset >= 0x100000000ull || span > 0x100000000ull - view->offset)
+        return -1;
+
+    const u32 old_count = s_off_rt_count;
+    rsx_linear_version previous;
+    if (old_count < MAX_OFF_RTS)
+        memcpy(&previous, &s_off_rt_views[old_count], sizeof(previous));
+    u32 slot;
+    if (rsx_linear_reserve_view(s_off_rt_views, MAX_OFF_RTS, &s_off_rt_count, view, &slot) != RSX_LINEAR_OK)
+        return -1;
+    if (slot < old_count) {
+        if (!s_d3d.off_rt[slot].res) return -1;
+        s_d3d.off_rt[slot].used = 1;
+        return (int)slot;
+    }
+
+    OffRT target;
+    memset(&target, 0, sizeof(target));
+    int mapped = 0;
+    if (!vm_base || s_d3d.off_rt[slot].res || s_d3d.off_rt[slot].up) goto fail;
+    const u32 ea = view->location == 1 ? cellGcmResolveLocated(1, (u32)view->offset) :
+                                        cellGcmResolveIO((u32)view->offset);
+    if ((view->location == 2 && !ea) || ea == UINT32_MAX ||
+            span > 0x100000000ull - ea ||
+            (uintptr_t)vm_base > UINTPTR_MAX - ((uint64_t)ea + span)) goto fail;
+
+    /* IO mappings use 1 MiB pages. Require a contiguous EA range instead of
+     * assuming the next guest page follows the first host page. */
+    for (uint64_t next = (view->offset & ~0xFFFFFull) + 0x100000ull;
+            next < view->offset + span; next += 0x100000ull) {
+        const u32 resolved = view->location == 1 ? cellGcmResolveLocated(1, (u32)next) :
+                                                  cellGcmResolveIO((u32)next);
+        if ((view->location == 2 && !resolved) || (uint64_t)resolved != ea + next - view->offset)
+            goto fail;
+    }
+    for (u32 y = 0; y < view->height; ++y)
+        if (!off_rt_seed_readable(vm_base + ea + (uint64_t)y * view->pitch, row_bytes))
+            goto fail;
+
+    D3D12_CPU_DESCRIPTOR_HANDLE rtv_handle, srv_handle;
+    s_d3d.rt_rtv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_d3d.rt_rtv_heap, &rtv_handle);
+    s_d3d.srv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_d3d.srv_heap, &srv_handle);
+    const UINT rtv_increment = s_d3d.device->lpVtbl->GetDescriptorHandleIncrementSize(
+        s_d3d.device, D3D12_DESCRIPTOR_HEAP_TYPE_RTV);
+    const uint64_t rtv_delta = (uint64_t)slot * rtv_increment;
+    const uint64_t srv_delta = (uint64_t)(RT_SRV_BASE + slot) * s_d3d.srv_inc;
+    if (!rtv_increment || rtv_delta > UINTPTR_MAX - rtv_handle.ptr ||
+            srv_delta > UINTPTR_MAX - srv_handle.ptr) goto fail;
+    rtv_handle.ptr += (SIZE_T)rtv_delta;
+    srv_handle.ptr += (SIZE_T)srv_delta;
+
+    D3D12_HEAP_PROPERTIES heap;
+    D3D12_RESOURCE_DESC texture;
+    D3D12_CLEAR_VALUE clear;
+    memset(&heap, 0, sizeof(heap)); memset(&texture, 0, sizeof(texture)); memset(&clear, 0, sizeof(clear));
+    heap.Type = D3D12_HEAP_TYPE_DEFAULT;
+    texture.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    texture.Width = view->width; texture.Height = view->height;
+    texture.DepthOrArraySize = 1; texture.MipLevels = 1;
+    texture.Format = DXGI_FORMAT_R8G8B8A8_UNORM; texture.SampleDesc.Count = 1;
+    texture.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+    texture.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+    clear.Format = texture.Format;
+    if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &heap,
+            D3D12_HEAP_FLAG_NONE, &texture, D3D12_RESOURCE_STATE_COPY_DEST, &clear,
+            &IID_ID3D12Resource, (void**)&target.res)) || !target.res) goto fail;
+
+    const u32 upload_pitch = ((u32)row_bytes + 255u) & ~255u;
+    const uint64_t upload_size = (uint64_t)upload_pitch * view->height;
+    D3D12_RESOURCE_DESC buffer;
+    memset(&buffer, 0, sizeof(buffer));
+    heap.Type = D3D12_HEAP_TYPE_UPLOAD;
+    buffer.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    buffer.Width = upload_size; buffer.Height = 1; buffer.DepthOrArraySize = 1;
+    buffer.MipLevels = 1; buffer.SampleDesc.Count = 1;
+    buffer.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &heap,
+            D3D12_HEAP_FLAG_NONE, &buffer, D3D12_RESOURCE_STATE_GENERIC_READ, NULL,
+            &IID_ID3D12Resource, (void**)&target.up)) || !target.up) goto fail;
+    void* upload = NULL;
+    const D3D12_RANGE no_read = {0, 0};
+    if (FAILED(target.up->lpVtbl->Map(target.up, 0, &no_read, &upload))) goto fail;
+    mapped = 1;
+    if (!upload) goto fail;
+    for (u32 y = 0; y < view->height; ++y) {
+        const uint8_t* src = vm_base + ea + (uint64_t)y * view->pitch;
+        uint8_t* dst = (uint8_t*)upload + (uint64_t)y * upload_pitch;
+        for (u32 x = 0; x < view->width; ++x) {
+            dst[x * 4] = src[x * 4 + 1];
+            dst[x * 4 + 1] = src[x * 4 + 2];
+            dst[x * 4 + 2] = src[x * 4 + 3];
+            dst[x * 4 + 3] = src[x * 4];
+        }
+    }
+    const D3D12_RANGE written = {0, (SIZE_T)upload_size};
+    target.up->lpVtbl->Unmap(target.up, 0, &written);
+    mapped = 0;
+
+    D3D12_SHADER_RESOURCE_VIEW_DESC srv;
+    memset(&srv, 0, sizeof(srv));
+    srv.Format = texture.Format; srv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+    srv.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+    srv.Texture2D.MipLevels = 1;
+    s_d3d.device->lpVtbl->CreateRenderTargetView(s_d3d.device, target.res, NULL, rtv_handle);
+    s_d3d.device->lpVtbl->CreateShaderResourceView(s_d3d.device, target.res, &srv, srv_handle);
+
+    /* Nothing below can report failure. Upload lifetime belongs to the caller;
+     * releasing it at the draw-record reset would invalidate this seed copy. */
+    D3D12_TEXTURE_COPY_LOCATION destination, source;
+    memset(&destination, 0, sizeof(destination)); memset(&source, 0, sizeof(source));
+    destination.pResource = target.res;
+    destination.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    source.pResource = target.up;
+    source.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    source.PlacedFootprint.Footprint.Format = texture.Format;
+    source.PlacedFootprint.Footprint.Width = view->width;
+    source.PlacedFootprint.Footprint.Height = view->height;
+    source.PlacedFootprint.Footprint.Depth = 1;
+    source.PlacedFootprint.Footprint.RowPitch = upload_pitch;
+    s_d3d.cmd_list->lpVtbl->CopyTextureRegion(s_d3d.cmd_list, &destination, 0, 0, 0, &source, NULL);
+    D3D12_RESOURCE_BARRIER barrier;
+    memset(&barrier, 0, sizeof(barrier));
+    barrier.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    barrier.Transition.pResource = target.res;
+    barrier.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+    barrier.Transition.StateAfter = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    barrier.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, 1, &barrier);
+    target.off = (u32)view->offset; target.w = view->width; target.h = view->height;
+    target.dxgi = (u32)texture.Format;
+    target.st = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE; target.used = 1;
+    s_d3d.off_rt[slot] = target;
+    return (int)slot;
+
+fail:
+    if (mapped) target.up->lpVtbl->Unmap(target.up, 0, NULL);
+    if (target.up) target.up->lpVtbl->Release(target.up);
+    if (target.res) target.res->lpVtbl->Release(target.res);
+    memcpy(&s_off_rt_views[old_count], &previous, sizeof(previous));
+    s_off_rt_count = old_count;
+    return -1;
+}
+
