+static void write_surface_metadata(FILE* out, const D3D12DrawRecord* record)
+{
+    const rsx_d3d12_surface_metadata absent = {0};
+    const rsx_d3d12_surface_metadata* m = record->is_vp ? &record->surface_meta : &absent;
+    fprintf(out, " surface_valid=%u pitch=%u/%u/%u/%u raw_rt=0x%X/0x%X/0x%X/0x%X"
+                 " clip=%u,%u,%ux%u scissor=%u,%u,%ux%u target=0x%X"
+                 " clear_flags=0x%X clear_depth=%.9g clear_stencil=0x%X surface_dma=unobserved\n",
+            m->valid, m->color_pitch[0], m->color_pitch[1], m->color_pitch[2], m->color_pitch[3],
+            m->color_offset[0], m->color_offset[1], m->color_offset[2], m->color_offset[3],
+            m->clip_x, m->clip_y, m->clip_w, m->clip_h,
+            m->scissor_x, m->scissor_y, m->scissor_w, m->scissor_h,
+            m->color_target, m->clear_flags, (double)m->clear_depth, m->clear_stencil);
