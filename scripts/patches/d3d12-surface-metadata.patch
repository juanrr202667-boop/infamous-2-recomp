+#ifndef RSX_D3D12_SURFACE_METADATA_H
+#define RSX_D3D12_SURFACE_METADATA_H
+
+#include "rsx_commands.h"
+#include <string.h>
+
+typedef struct rsx_d3d12_surface_metadata {
+    u32 valid; /* State was available; this is not layout validation. */
+    u32 color_offset[4], color_pitch[4];
+    u32 clip_x, clip_y, clip_w, clip_h;
+    u32 scissor_x, scissor_y, scissor_w, scissor_h;
+    u32 color_target;
+    u32 clear_flags;
+    float clear_depth;
+    u32 clear_stencil;
+} rsx_d3d12_surface_metadata;
+
+/* Copy the state at this operation, without inferring missing DMA locations. */
+static inline void rsx_d3d12_snapshot_surface(rsx_d3d12_surface_metadata* out,
+        const rsx_state* state, u32 flags, float depth, u8 stencil)
+{
+    memset(out, 0, sizeof(*out));
+    out->clear_flags = flags;
+    out->clear_depth = depth;
+    out->clear_stencil = stencil;
+    if (!state) return;
+
+    out->valid = 1;
+    memcpy(out->color_offset, state->surface_color_offset, sizeof(out->color_offset));
+    memcpy(out->color_pitch, state->surface_color_pitch, sizeof(out->color_pitch));
+    out->clip_x = state->surface_clip_x;
+    out->clip_y = state->surface_clip_y;
+    out->clip_w = state->surface_clip_w;
+    out->clip_h = state->surface_clip_h;
+    out->scissor_x = state->scissor_x;
+    out->scissor_y = state->scissor_y;
+    out->scissor_w = state->scissor_w;
+    out->scissor_h = state->scissor_h;
+    out->color_target = state->color_target;
+}
+
+#endif
