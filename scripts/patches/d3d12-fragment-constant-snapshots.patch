diff --git a/libs/video/rsx_d3d12_fragment_constants.h b/libs/video/rsx_d3d12_fragment_constants.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_d3d12_fragment_constants.h
@@ -0,0 +1,58 @@
+#ifndef RSX_D3D12_FRAGMENT_CONSTANTS_H
+#define RSX_D3D12_FRAGMENT_CONSTANTS_H
+
+#include <stdio.h>
+#include <string.h>
+#include "rsx_fp_decompiler.h"
+#include "rsx_d3d12_guest_pipeline.h"
+
+/* Keep structural HLSL independent of per-draw literals while consuming the
+ * existing b1 bank. Explicit offsets avoid the generic decompiler's compact
+ * layout being mistaken for this backend's scales/alpha/constants layout. */
+static inline int rsx_d3d12_decompile_fragment(const u8* ucode, u32 max_bytes,
+        u32 control, u32 cube_mask, char* out, u32 capacity, u32* constant_count)
+{
+    u32 count = 0;
+    if (constant_count) *constant_count = 0;
+    if (!ucode || !out || !capacity || !max_bytes || max_bytes > 4096u) return -1;
+    int instructions = rsx_fp_decompile_buffered_ex(ucode, max_bytes, control,
+        cube_mask, out, capacity, &count);
+    if (instructions < 0 || count > RSX_D3D12_FP_CONSTANT_COUNT) return -1;
+    const char* declaration = "cbuffer PSConstants : register(b1) {\n";
+    char* begin = strstr(out, declaration);
+    char* end = begin ? strstr(begin, "\n};\n") : NULL;
+    if (!end) return -1;
+    end += strlen("\n};\n");
+    char replacement[256];
+    int length = snprintf(replacement, sizeof(replacement),
+        "cbuffer PSConstants : register(b1) {\n"
+        "    float4 fp_alpha : packoffset(c%u);\n"
+        "    float4 fp_constants[%u] : packoffset(c%u);\n"
+        "};\n",
+        RSX_D3D12_FP_ALPHA_FLOAT_OFFSET / 4u, RSX_D3D12_FP_CONSTANT_COUNT,
+        RSX_D3D12_FP_CONSTANT_FLOAT_OFFSET / 4u);
+    if (length < 0 || (size_t)length >= sizeof(replacement)) return -1;
+    size_t prefix = (size_t)(begin - out), tail = strlen(end) + 1;
+    if (prefix + (size_t)length + tail > capacity) return -1;
+    memmove(begin + length, end, tail);
+    memcpy(begin, replacement, (size_t)length);
+    if (constant_count) *constant_count = count;
+    return instructions;
+}
+
+/* Collector validation precedes publication. Its existing word conversion and
+ * non-finite policy remain unchanged; no unused slot retains an older draw. */
+static inline int rsx_d3d12_snapshot_fragment_constants(float* bank,
+        const u8* ucode, u32 max_bytes)
+{
+    rsx_fp_constant_block payload;
+    if (!bank || !ucode || !max_bytes || max_bytes > 4096u) return -1;
+    int count = rsx_fp_collect_constants(ucode, max_bytes, &payload);
+    if (count < 0 || payload.count > RSX_D3D12_FP_CONSTANT_COUNT) return -1;
+    float* constants = bank + RSX_D3D12_FP_CONSTANT_FLOAT_OFFSET;
+    memset(constants, 0, RSX_D3D12_FP_CONSTANT_COUNT * 4u * sizeof(float));
+    memcpy(constants, payload.values, payload.count * 4u * sizeof(u32));
+    return count;
+}
+
+#endif
