-                rsx_capture_frame(fi, s_dbg_last_draws, s_cap_done);
+            const char* allow_empty = getenv("RSX_CAP_ALLOW_EMPTY");
+            if (s_d3d.frame_count >= target &&
+                (s_dbg_last_draws > 0 || (allow_empty && !strcmp(allow_empty, "1")))) {
+                rsx_capture_frame(fi, s_dbg_last_draws, rearm_enabled ? s_cap_total : s_cap_done);
+                fflush(stdout);
                 s_cap_done++;
+                s_cap_total++;
             }
         }
       } }
