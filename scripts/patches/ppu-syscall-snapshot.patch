           if (e && *e) ppu_guard_page((uint32_t)strtoul(e, 0, 16)); } }
     uint64_t num = ctx->gpr[11];
+    struct SnapshotGuard {
+        ScSnapshot* s; unsigned tid; uint64_t previous;
+        ~SnapshotGuard() { if (s) s->slots[tid].store(previous, std::memory_order_release); }
+    } snapshot{nullptr, 0, 0};
+    if (ScSnapshot* s = sc_snapshot()) {
