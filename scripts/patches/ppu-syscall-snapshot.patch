+/* Optional bounded observer. Each slot is one atomic value: high word is
+ * syscall+1 (zero means idle), low word is its guest LR. The observer never
+ * reads a guest context or guest memory, and can see calls already in flight
+ * when its delay expires. The delay is relative to the first lv2_syscall. */
+struct ScSnapshot {
+    std::atomic<uint64_t> slots[PS3_SC_INFLIGHT_MAX]{};
+    std::atomic<bool> seen[PS3_SC_INFLIGHT_MAX]{};
+    unsigned delay_ms, interval_ms;
+    static DWORD WINAPI observe(LPVOID arg) {
+        ScSnapshot* s = static_cast<ScSnapshot*>(arg);
+        Sleep(s->delay_ms);
+        for (unsigned n = 0; n < 1200; ++n) {
+            for (unsigned t = 0; t < PS3_SC_INFLIGHT_MAX; ++t) {
+                if (!s->seen[t].load(std::memory_order_acquire)) continue;
+                const uint64_t v = s->slots[t].load(std::memory_order_acquire);
+                if (v) fprintf(stderr, "[sc-snapshot] tid=%u syscall=%u lr=%08X\n",
+                               t, (unsigned)(v >> 32) - 1, (unsigned)v);
+                else fprintf(stderr, "[sc-snapshot] tid=%u idle\n", t);
+            }
+            fflush(stderr);
+            Sleep(s->interval_ms);
+        }
+        return 0;
+    }
+};
+static ScSnapshot* sc_snapshot() {
+    static ScSnapshot* s = []() -> ScSnapshot* {
+        const char* e = getenv("PS3_SC_SNAPSHOT_AFTER_MS");
+        if (!e || !*e) return nullptr;
+        char* end = nullptr;
+        unsigned long delay = strtoul(e, &end, 10);
+        if (*end || delay == 0 || delay > 3600000) return nullptr;
+        unsigned long interval = 1000;
+        const char* i = getenv("PS3_SC_SNAPSHOT_INTERVAL_MS");
+        if (i && *i) {
+            interval = strtoul(i, &end, 10);
+            if (*end || interval < 10 || interval > 60000) return nullptr;
+        }
+        ScSnapshot* p = new ScSnapshot{};
+        p->delay_ms = (unsigned)delay; p->interval_ms = (unsigned)interval;
+        HANDLE thread = CreateThread(nullptr, 0, ScSnapshot::observe, p, 0, nullptr);
+        if (!thread) { delete p; return nullptr; }
+        CloseHandle(thread);
+        return p; /* process lifetime: observer may outlive the guest thread */
+    }();
+    return s;
+}
+
