+        if (tid < PS3_SC_INFLIGHT_MAX && num < UINT32_MAX) {
+            snapshot.s = s; snapshot.tid = (unsigned)tid;
+            const uint64_t value = ((num + 1) << 32) | (uint32_t)ctx->lr;
+            snapshot.previous = s->slots[tid].exchange(value, std::memory_order_acq_rel);
+            s->seen[tid].store(true, std::memory_order_release);
