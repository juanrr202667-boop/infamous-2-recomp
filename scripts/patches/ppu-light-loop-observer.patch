+/* Samples are atomically published by the guest thread itself. No background
+ * reader dereferences a ppu_context and no guest memory is accessed here. */
+struct I2LightLoopObserver {
+    std::atomic<uint64_t> scan{0}, call{0}, done{0};
+    std::atomic<uint32_t> r26{0}, r27{0}, r28{0}, r29{0}, target{0}, result{0};
+    unsigned delay, interval, maximum;
+    static DWORD WINAPI run(LPVOID arg) {
+        auto* s = static_cast<I2LightLoopObserver*>(arg);
+        Sleep(s->delay);
+        for (unsigned n = 0; n < s->maximum; ++n) {
+            fprintf(stderr, "[i2-light-loop] tid=1 scan=%llu call=%llu done=%llu r26=%08X r27=%08X r28=%08X r29=%08X target=%08X result=%08X concurrent=1\n",
+                    (unsigned long long)s->scan.load(), (unsigned long long)s->call.load(),
+                    (unsigned long long)s->done.load(), s->r26.load(), s->r27.load(),
+                    s->r28.load(), s->r29.load(), s->target.load(), s->result.load());
+            fflush(stderr);
+            Sleep(s->interval);
+        }
+        return 0;
+    }
+};
+static I2LightLoopObserver* i2_light_loop_observer() {
+    static I2LightLoopObserver* s = []() -> I2LightLoopObserver* {
+        const char* v = getenv("I2_LIGHT_LOOP_AFTER_MS"); char* end = nullptr;
+        if (!v || !*v) return nullptr;
+        unsigned long delay = strtoul(v, &end, 10);
+        if (*end || !delay || delay > 3600000) return nullptr;
+        unsigned long interval = 1000, maximum = 60;
+        v = getenv("I2_LIGHT_LOOP_INTERVAL_MS");
+        if (v && *v) { interval = strtoul(v, &end, 10); if (*end || !interval || interval > 60000) return nullptr; }
+        v = getenv("I2_LIGHT_LOOP_MAX");
+        if (v && *v) { maximum = strtoul(v, &end, 10); if (*end || !maximum || maximum > 10000) return nullptr; }
+        auto* p = new I2LightLoopObserver{};
+        p->delay = (unsigned)delay; p->interval = (unsigned)interval; p->maximum = (unsigned)maximum;
+        HANDLE h = CreateThread(nullptr, 0, I2LightLoopObserver::run, p, 0, nullptr);
+        if (!h) { delete p; return nullptr; } CloseHandle(h); return p;
+    }();
+    return s;
+}
+extern "C" void i2_light_loop_trace(ppu_context* ctx, unsigned phase) {
+    const DWORD incoming = GetLastError();
+    auto* s = i2_light_loop_observer();
+    if (s && ctx && ctx->thread_id == 1) {
+        if (phase == 0) {
+            s->r26.store((uint32_t)ctx->gpr[26], std::memory_order_relaxed);
+            s->r27.store((uint32_t)ctx->gpr[27], std::memory_order_relaxed);
+            s->r28.store((uint32_t)ctx->gpr[28], std::memory_order_relaxed);
+            s->r29.store((uint32_t)ctx->gpr[29], std::memory_order_relaxed);
+            s->scan.fetch_add(1, std::memory_order_relaxed);
+        } else if (phase == 1) {
+            s->target.store((uint32_t)ctx->ctr, std::memory_order_relaxed);
+            s->call.fetch_add(1, std::memory_order_relaxed);
+        } else if (phase == 2) {
+            s->result.store((uint32_t)ctx->gpr[3], std::memory_order_relaxed);
+            s->done.fetch_add(1, std::memory_order_relaxed);
+        }
+    }
+    SetLastError(incoming);
+}
