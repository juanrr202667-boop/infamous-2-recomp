+/* The NV3089 source origin (in_uv) is 12.4 fixed point. With a 20.12 step the
+ * origin must be shifted by 16 before the >>20 that recovers the pixel, not 8:
+ * an 8-bit shift made it 256x too small and every copy started at pixel 0,0 of
+ * the surface. */
+static inline u64 nv3089_origin(u32 p) { return (u64)p << 16; }
+
