+        u32 height = display ? s_display_bridge.height : s_d3d.off_rt[slot].h;
+        D3D12_RECT rect = temporal_clear_rect(dr, width, height);
+        if (rect.left == rect.right || rect.top == rect.bottom) continue;
+        D3D12_CPU_DESCRIPTOR_HANDLE rtv = display ? display_rtv : off_rt_rtv(slot);
+        s_d3d.cmd_list->lpVtbl->ClearRenderTargetView(s_d3d.cmd_list, rtv, dr->cc, 1, &rect);
