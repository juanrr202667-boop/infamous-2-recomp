+/* Presentation gates accept a real display color clear. The frame-boundary
+ * heuristic above still asks specifically for draws and excludes clears. */
+static inline int rsx_d3d12_color_write_targets_display(u32 rt_off,
+        const u32 rt_mrt[3], int is_clear, u32 clear_flags, u32 color_target)
+{
+    if (is_clear && !(clear_flags & 0xF0u)) return 0;
+    return rsx_d3d12_draw_targets_display_ext(rt_off, rt_mrt, 0, color_target);
+}
