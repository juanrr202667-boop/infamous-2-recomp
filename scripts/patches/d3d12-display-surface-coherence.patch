diff --git a/libs/video/rsx_d3d12_display_bridge.h b/libs/video/rsx_d3d12_display_bridge.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_d3d12_display_bridge.h
@@ -0,0 +1,129 @@
+#ifndef RSX_D3D12_DISPLAY_BRIDGE_H
+#define RSX_D3D12_DISPLAY_BRIDGE_H
+
+#include "rsx_d3d12_linear_copy.h"
+
+/* Both resources are borrowed and must outlive the submitted command list's
+ * fence. Display is RENDER_TARGET on entry and return; its caller owns that
+ * invariant. The canonical state pointer belongs to the pending batch. */
+typedef struct rsx_d3d12_display_bridge_context {
+    ID3D12GraphicsCommandList* command_list;
+    ID3D12Resource* display;
+    uint32_t width, height;
+    DXGI_FORMAT format;
+    HRESULT last_hr;
+    const char* last_error;
+} rsx_d3d12_display_bridge_context;
+
+static inline int rsx_d3d12_display_bridge_fail(
+        rsx_d3d12_display_bridge_context* context, const char* stage)
+{
+    if (context) {
+        context->last_hr = E_INVALIDARG;
+        context->last_error = stage;
+    }
+    return 0;
+}
+
+static inline int rsx_d3d12_display_bridge_description_valid(
+        ID3D12Resource* resource, uint32_t width, uint32_t height, DXGI_FORMAT format)
+{
+    D3D12_RESOURCE_DESC desc;
+    resource->lpVtbl->GetDesc(resource, &desc);
+    return desc.Dimension == D3D12_RESOURCE_DIMENSION_TEXTURE2D &&
+           desc.Width == width && desc.Height == height &&
+           desc.DepthOrArraySize == 1 && desc.MipLevels == 1 &&
+           desc.Format == format && desc.SampleDesc.Count == 1 &&
+           desc.SampleDesc.Quality == 0;
+}
+
+/* Record a complete copy only after both resources and the canonical tracker
+ * have been validated. There is no allocation, descriptor or epoch here.
+ * Recording commands has no HRESULT; a later failure requires discarding the
+ * complete pending command list, as for the other temporal copy adapters. */
+static inline int rsx_d3d12_display_bridge_copy(
+        rsx_d3d12_display_bridge_context* context,
+        const rsx_d3d12_linear_resource* canonical, int to_display)
+{
+    if (!context || !context->command_list || !context->display || !canonical ||
+            !canonical->resource || !canonical->state ||
+            canonical->resource == context->display ||
+            !context->width || !context->height ||
+            context->width > D3D12_REQ_TEXTURE2D_U_OR_V_DIMENSION ||
+            context->height > D3D12_REQ_TEXTURE2D_U_OR_V_DIMENSION ||
+            context->format != DXGI_FORMAT_R8G8B8A8_UNORM ||
+            canonical->format != context->format ||
+            !rsx_linear_view_valid(&canonical->view) ||
+            canonical->view.width != context->width ||
+            canonical->view.height != context->height ||
+            canonical->view.bytes_per_pixel != 4 || canonical->view.format_id != 0x85)
+        return rsx_d3d12_display_bridge_fail(context,
+                to_display ? "display.begin.input" : "display.end.input");
+    if (!rsx_d3d12_display_bridge_description_valid(canonical->resource,
+            context->width, context->height, context->format))
+        return rsx_d3d12_display_bridge_fail(context,
+                to_display ? "display.begin.canonical" : "display.end.canonical");
+    if (!rsx_d3d12_display_bridge_description_valid(context->display,
+            context->width, context->height, context->format))
+        return rsx_d3d12_display_bridge_fail(context,
+                to_display ? "display.begin.display" : "display.end.display");
+
+    D3D12_RESOURCE_STATES canonical_copy = to_display ?
+        D3D12_RESOURCE_STATE_COPY_SOURCE : D3D12_RESOURCE_STATE_COPY_DEST;
+    D3D12_RESOURCE_STATES display_copy = to_display ?
+        D3D12_RESOURCE_STATE_COPY_DEST : D3D12_RESOURCE_STATE_COPY_SOURCE;
+    D3D12_RESOURCE_BARRIER barriers[2];
+    UINT count = 0;
+    memset(barriers, 0, sizeof(barriers));
+    if (*canonical->state != canonical_copy) {
+        D3D12_RESOURCE_BARRIER* barrier = &barriers[count++];
+        barrier->Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        barrier->Transition.pResource = canonical->resource;
+        barrier->Transition.StateBefore = *canonical->state;
+        barrier->Transition.StateAfter = canonical_copy;
+        barrier->Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    }
+    D3D12_RESOURCE_BARRIER* display_barrier = &barriers[count++];
+    display_barrier->Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    display_barrier->Transition.pResource = context->display;
+    display_barrier->Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    display_barrier->Transition.StateAfter = display_copy;
+    display_barrier->Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    context->command_list->lpVtbl->ResourceBarrier(context->command_list, count, barriers);
+    *canonical->state = canonical_copy;
+
+    context->command_list->lpVtbl->CopyResource(context->command_list,
+            to_display ? context->display : canonical->resource,
+            to_display ? canonical->resource : context->display);
+
+    memset(&barriers[0], 0, sizeof(barriers[0]));
+    barriers[0].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    barriers[0].Transition.pResource = context->display;
+    barriers[0].Transition.StateBefore = display_copy;
+    barriers[0].Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    barriers[0].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    context->command_list->lpVtbl->ResourceBarrier(context->command_list, 1, barriers);
+    context->last_hr = S_OK;
+    context->last_error = NULL;
+    return 1;
+}
+
+/* Preserve the entire canonical view before a partial display draw/clear.
+ * Canonical finishes COPY_SOURCE; display finishes RENDER_TARGET. */
+static inline int rsx_d3d12_display_bridge_begin(
+        rsx_d3d12_display_bridge_context* context,
+        const rsx_d3d12_linear_resource* canonical)
+{
+    return rsx_d3d12_display_bridge_copy(context, canonical, 1);
+}
+
+/* Make the display write visible in canonical storage before publication.
+ * Canonical finishes COPY_DEST; display finishes RENDER_TARGET. */
+static inline int rsx_d3d12_display_bridge_end(
+        rsx_d3d12_display_bridge_context* context,
+        const rsx_d3d12_linear_resource* canonical)
+{
+    return rsx_d3d12_display_bridge_copy(context, canonical, 0);
+}
+
+#endif
