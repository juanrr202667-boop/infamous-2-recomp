+/* Active members come from the selector, not their addresses. Address zero
+ * is valid guest storage and must not shorten an MRT prefix. */
+static inline int rsx_declared_surface_target_count(const rsx_d3d12_surface_metadata* m)
+{
+    if (!m || !m->valid) return RSX_LINEAR_META_ABSENT;
+    switch (m->color_target) {
+    case CELL_GCM_SURFACE_TARGET_0:
+    case CELL_GCM_SURFACE_TARGET_1: return 1;
+    case CELL_GCM_SURFACE_TARGET_MRT1: return 2;
+    case CELL_GCM_SURFACE_TARGET_MRT2: return 3;
+    case CELL_GCM_SURFACE_TARGET_MRT3: return 4;
+    default: return RSX_LINEAR_META_UNSUPPORTED;
+    }
+}
 
