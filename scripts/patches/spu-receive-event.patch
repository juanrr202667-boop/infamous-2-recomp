+uint32_t sys_event_queue_receive_spu(uint32_t queue_id, sys_event_t* event, int wait)
+{
+    if (!queue_id || queue_id > SYS_EVENT_QUEUE_MAX) return CELL_ESRCH;
+    sys_event_queue_info* q = &g_sys_event_queues[queue_id - 1];
+    if (!q->active) return CELL_ESRCH;
+    if (q->type != SYS_SPU_QUEUE) return CELL_EINVAL;
+    uint32_t result = CELL_OK;
+#ifdef _WIN32
+    EnterCriticalSection(&q->lock);
+    while (wait && !q->count && !q->cancelled)
+        SleepConditionVariableCS(&q->not_empty, &q->lock, INFINITE);
+#else
+    pthread_mutex_lock(&q->lock);
+    while (wait && !q->count && !q->cancelled)
+        pthread_cond_wait(&q->not_empty, &q->lock);
+#endif
+    if (q->cancelled) result = CELL_ECANCELED;
+    else if (!q->count) result = CELL_EBUSY;
+    else {
+        *event = q->buffer[q->head];
+        q->head = (q->head + 1) % q->capacity;
+        --q->count;
+    }
+#ifdef _WIN32
+    LeaveCriticalSection(&q->lock);
+#else
+    pthread_mutex_unlock(&q->lock);
+#endif
+    return result;
+}

