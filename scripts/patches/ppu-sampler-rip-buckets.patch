+/* Optional bounded RIP histogram for one suspect guest function. Only the
+ * sampler thread touches these fields; no guest memory or context is read. */
+static unsigned s_rip_after = 0, s_rip_window_ms = 1000, s_rip_max = 10;
+static unsigned s_rip_windows = 0, s_rip_used = 0, s_rip_overflow = 0;
+static uint32_t s_rip_bucket[128], s_rip_count[128];
+static uint64_t s_rip_next = 0;
+static uintptr_t s_rip_target = 0;
+
+static void samp_rip_sample(uintptr_t rip, uint64_t now, uint64_t t0) {
+    if (!s_rip_after || s_rip_windows >= s_rip_max || now - t0 < s_rip_after || !s_rip_target) return;
+    DWORD64 image = 0;
+    RUNTIME_FUNCTION* rf = RtlLookupFunctionEntry((DWORD64)rip, &image, nullptr);
+    if (!rf || image + rf->BeginAddress != s_rip_target || rip >= image + rf->EndAddress) return;
+    const uint32_t bucket = (uint32_t)((rip - s_rip_target) & ~(uintptr_t)15);
+    unsigned i = 0; while (i < s_rip_used && s_rip_bucket[i] != bucket) ++i;
+    if (i == 128) { ++s_rip_overflow; return; }
+    if (i == s_rip_used) { s_rip_bucket[i] = bucket; ++s_rip_used; }
+    ++s_rip_count[i];
+}
+static void samp_rip_report(uint64_t now, uint64_t t0) {
+    if (!s_rip_after || s_rip_windows >= s_rip_max || now - t0 < s_rip_after) return;
+    if (!s_rip_next) s_rip_next = t0 + s_rip_after + s_rip_window_ms;
+    if (now < s_rip_next) return;
+    fprintf(stderr, "[samp-rip] window=%u elapsed_ms=%llu overflow=%u\n",
+            ++s_rip_windows, (unsigned long long)(now - t0), s_rip_overflow);
+    for (unsigned i = 0; i < s_rip_used; ++i)
+        fprintf(stderr, "[samp-rip] bucket=%08X count=%u\n", s_rip_bucket[i], s_rip_count[i]);
+    fflush(stderr); s_rip_used = s_rip_overflow = 0;
+    memset(s_rip_count, 0, sizeof s_rip_count); s_rip_next = now + s_rip_window_ms;
+}
 
