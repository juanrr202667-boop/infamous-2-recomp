+#define MAX_DEFERRED_RELEASES 256
+static ID3D12Resource* s_deferred_releases[MAX_DEFERRED_RELEASES];
+static u32 s_deferred_release_count = 0;
+
+static void defer_resource_release(ID3D12Resource* res)
+{
+    if (!res) return;
+    if (s_deferred_release_count < MAX_DEFERRED_RELEASES) {
+        s_deferred_releases[s_deferred_release_count++] = res;
+    } else {
+        fprintf(stderr, "[D3D12] warning: deferred release queue overflow, forcing GPU wait\n");
+        wait_for_gpu();
+        res->lpVtbl->Release(res);
+    }
+}
+
+static void flush_deferred_releases(void)
+{
+    for (u32 i = 0; i < s_deferred_release_count; i++) {
+        if (s_deferred_releases[i]) {
+            s_deferred_releases[i]->lpVtbl->Release(s_deferred_releases[i]);
+            s_deferred_releases[i] = NULL;
+        }
+    }
+    s_deferred_release_count = 0;
+}
