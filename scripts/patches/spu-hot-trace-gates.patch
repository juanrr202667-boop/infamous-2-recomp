diff --git a/runtime/spu/spu_channels.c b/runtime/spu/spu_channels.c
--- a/runtime/spu/spu_channels.c
+++ b/runtime/spu/spu_channels.c
@@ -30,6 +30,31 @@
 #ifdef __cplusplus
 extern "C" {
 #endif
+
+/* 0 = uninitialized, 1 = disabled, 2 = enabled. Concurrent first callers
+ * may read the same process environment; only one complete result publishes.
+ * Trace settings are immutable for the lifetime of this process. */
+static int spu_trace_setting(volatile LONG* cache, const char* name)
+{
+    LONG setting = InterlockedCompareExchange(cache, 0, 0);
+    if (!setting) {
+        const char* value = getenv(name);
+        LONG wanted = value && *value && strcmp(value, "0") != 0 ? 2 : 1;
+        setting = InterlockedCompareExchange(cache, wanted, 0);
+        if (!setting) setting = wanted;
+    }
+    return setting == 2;
+}
+int spu_dma_list_trace_enabled(void)
+{
+    static volatile LONG cache = 0;
+    return spu_trace_setting(&cache, "SPU_DMA_LIST_TRACE");
+}
+int spu_pm_trace_enabled(void)
+{
+    static volatile LONG cache = 0;
+    return spu_trace_setting(&cache, "SPURS_PM_TRACE");
+}
 
