--- /dev/null
+++ b/libs/video/gcm_fifo_profile.h
@@ -0,0 +1,167 @@
+#ifndef GCM_FIFO_PROFILE_H
+#define GCM_FIFO_PROFILE_H
+
+/* Opt-in observation only. No per-header hook or shared accumulator. */
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#ifdef _WIN32
+#include <windows.h>
+#else
+#include <time.h>
+#include <pthread.h>
+#endif
+
+#if defined(_MSC_VER)
+#define GCM_PROFILE_TLS __declspec(thread)
+#elif defined(__cplusplus)
+#define GCM_PROFILE_TLS thread_local
+#else
+#define GCM_PROFILE_TLS _Thread_local
+#endif
+
+typedef struct gcm_fifo_probe {
+    uint32_t get_start, get_end, put;
+    uint32_t iterations;
+    int has_context;
+    const char* reason;
+    uint64_t tail_start_ns;
+} gcm_fifo_probe;
+
+typedef struct gcm_fifo_profile_window {
+    uint64_t start_ns, calls, lock_wait_ns, walker_ns, tail_ns;
+    uint64_t entry_empty, iterations, pure_park, work_park, no_context;
+    uint64_t empty_walker_ns, empty_lock_wait_ns, pure_park_walker_ns;
+    uint64_t work_calls, work_walker_ns, no_context_walker_ns;
+    uint64_t cpu_start_ns;
+    int cpu_available;
+} gcm_fifo_profile_window;
+
+static GCM_PROFILE_TLS gcm_fifo_profile_window s_gcm_profile_window;
+
+static int gcm_fifo_profile_enabled(void)
+{
+    static GCM_PROFILE_TLS int enabled = -1;
+    if (enabled < 0) {
+        const char* e = getenv("GCM_FIFO_PROFILE");
+        enabled = e && strcmp(e, "1") == 0;
+    }
+    return enabled;
+}
+
+static uint64_t gcm_fifo_profile_now(void)
+{
+#ifdef _WIN32
+    static GCM_PROFILE_TLS uint64_t frequency;
+    LARGE_INTEGER counter;
+    if (!frequency) {
+        LARGE_INTEGER f;
+        QueryPerformanceFrequency(&f);
+        frequency = (uint64_t)f.QuadPart;
+    }
+    QueryPerformanceCounter(&counter);
+    return (uint64_t)counter.QuadPart / frequency * 1000000000ULL +
+        (uint64_t)counter.QuadPart % frequency * 1000000000ULL / frequency;
+#else
+    struct timespec t;
+    clock_gettime(CLOCK_MONOTONIC, &t);
+    return (uint64_t)t.tv_sec * 1000000000ULL + (uint64_t)t.tv_nsec;
+#endif
+}
+
+static int gcm_fifo_profile_cpu(uint64_t* ns)
+{
+#ifdef _WIN32
+    FILETIME created, exited, kernel, user;
+    if (!GetThreadTimes(GetCurrentThread(), &created, &exited, &kernel, &user))
+        return 0;
+    *ns = ((((uint64_t)kernel.dwHighDateTime << 32) | kernel.dwLowDateTime) +
+           (((uint64_t)user.dwHighDateTime << 32) | user.dwLowDateTime)) * 100ULL;
+    return 1;
+#else
+    (void)ns;
+    return 0; /* Explicitly unavailable; wall time is never substituted. */
+#endif
+}
+
+static uint64_t gcm_fifo_profile_begin(void)
+{
+    gcm_fifo_profile_window* w = &s_gcm_profile_window;
+    const uint64_t now = gcm_fifo_profile_now();
+    if (!w->calls && !w->start_ns) {
+        w->start_ns = now;
+        w->cpu_available = gcm_fifo_profile_cpu(&w->cpu_start_ns);
+        /* The baseline query is diagnostic overhead, not FIFO lock wait. */
+        return gcm_fifo_profile_now();
+    }
+    return now;
+}
+
+static void gcm_fifo_profile_record(const gcm_fifo_probe* p,
+                                    uint64_t begin, uint64_t locked, uint64_t end)
+{
+    gcm_fifo_profile_window* w = &s_gcm_profile_window;
+    w->calls++;
+    w->lock_wait_ns += locked - begin;
+    w->walker_ns += end - locked;
+    if (p->tail_start_ns) w->tail_ns += end - p->tail_start_ns;
+    w->iterations += p->iterations;
+    const int empty = p->has_context && !p->iterations && p->get_start == p->put;
+    const int parked = p->reason && !strcmp(p->reason, "jump-park");
+    if (!p->has_context) {
+        w->no_context++;
+        w->no_context_walker_ns += end - locked;
+    } else if (empty) {
+        w->entry_empty++;
+        w->empty_walker_ns += end - locked;
+        w->empty_lock_wait_ns += locked - begin;
+    } else if (!(parked && p->iterations == 1)) {
+        w->work_calls++;
+        w->work_walker_ns += end - locked;
+    }
+    if (parked) {
+        if (p->iterations == 1) {
+            w->pure_park++;
+            w->pure_park_walker_ns += end - locked;
+        }
+        else w->work_park++;
+    }
+    if (end - w->start_ns >= 1000000000ULL) {
+        uint64_t cpu_end = 0;
+        const int cpu_ok = gcm_fifo_profile_cpu(&cpu_end);
+        const int cpu_available = w->cpu_available && cpu_ok && cpu_end >= w->cpu_start_ns;
+#ifdef _WIN32
+        const unsigned long tid = GetCurrentThreadId();
+#else
+        const unsigned long tid = (unsigned long)pthread_self();
+#endif
+        fprintf(stderr,
+            "[gcm-fifo-profile] tid=%lu window_ns=%llu end_ns=%llu calls=%llu "
+            "lock_wait_ns=%llu walker_ns=%llu tail_ns=%llu tail_subset=1 "
+            "entry_empty=%llu iterations=%llu pure_park=%llu work_park=%llu "
+            "empty_walker_ns=%llu empty_lock_wait_ns=%llu pure_park_walker_ns=%llu "
+            "work_calls=%llu work_walker_ns=%llu no_context=%llu no_context_walker_ns=%llu "
+            "cpu_available=%d cpu_ns=%llu cpu_boundary_approx=1 "
+            "last_get_start=%08X last_get_end=%08X last_put=%08X last_reason=%s\n",
+            tid, (unsigned long long)(end - w->start_ns), (unsigned long long)end,
+            (unsigned long long)w->calls,
+            (unsigned long long)w->lock_wait_ns, (unsigned long long)w->walker_ns,
+            (unsigned long long)w->tail_ns, (unsigned long long)w->entry_empty,
+            (unsigned long long)w->iterations, (unsigned long long)w->pure_park,
+            (unsigned long long)w->work_park, (unsigned long long)w->empty_walker_ns,
+            (unsigned long long)w->empty_lock_wait_ns, (unsigned long long)w->pure_park_walker_ns,
+            (unsigned long long)w->work_calls, (unsigned long long)w->work_walker_ns,
+            (unsigned long long)w->no_context, (unsigned long long)w->no_context_walker_ns,
+            cpu_available, (unsigned long long)(cpu_available ? cpu_end - w->cpu_start_ns : 0),
+            p->get_start, p->get_end, p->put, p->reason ? p->reason : "unknown");
+        /* Reuse this CPU sample as the next window's baseline. Reporting CPU
+         * cost is included in the following window, rather than hidden. */
+        memset(w, 0, sizeof(*w));
+        w->start_ns = end;
+        w->cpu_start_ns = cpu_end;
+        w->cpu_available = cpu_ok;
+    }
+}
+
+#endif
