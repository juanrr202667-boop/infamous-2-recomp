+/* Actual WAIT_SIGNAL sleepers, protected by s_sig_lock. A node lives on the
+ * waiting thread's stack until it consumes a signal or leaves the wait. The
+ * older parked-object hints below are not an authoritative waiter registry. */
+typedef struct spu_signal_waiter {
+    uint32_t taskset, task, line;
+    struct spu_signal_waiter* next;
+} spu_signal_waiter;
+static spu_signal_waiter* s_signal_waiters;
+
+/* Lock order: signal lock -> lock-line lock. The SPU commit notifier is called
+ * only AFTER releasing lock-line. Test-and-consume is one transaction against
+ * SPU atomic memcpy, so clearing one task cannot overwrite a peer's signal. */
+static int spu_task_signal_update(uint32_t taskset, uint32_t task, int set)
+{
+    uint32_t ea = taskset + CSTS_SIGNALLED + (task / 32u) * 4u;
+    uint32_t mask = 0x80000000u >> (task % 32u);
+    spu_lockline_lock();
+    uint32_t bits = vm_read32(ea);
+    int pending = (bits & mask) != 0;
+    uint32_t value = set ? bits | mask : bits & ~mask;
+    if (set || pending) {
+        uint32_t raw = ps3_bswap32(value);
+        memcpy(vm_ptr8(ea), &raw, sizeof(raw));
+        spu_coh_notify_write(ea);
+    }
+    spu_lockline_unlock();
+    if (set || pending) {
+        PS3_WW_CHECK(ea, value, 4);
+        if (g_resv_store_active > 0) ppu_resv_break_store(ea);
+    }
+    return pending;
+}
+
+static void spu_signal_waiter_remove(spu_signal_waiter* waiter)
+{
+    spu_signal_waiter** link = &s_signal_waiters;
+    while (*link != waiter) link = &(*link)->next;
+    *link = waiter->next;
+}
+
+/* Notify committed guest state, never invent a signal bit. A commit before
+ * registration is latched in guest memory; a later commit takes the lock that
+ * the condition wait atomically releases, preventing a lost host wake. */
+void spu_taskset_line_committed(uint32_t line, const spu_context* producer,
+                               uint32_t command)
+{
+    struct wake_record { uint32_t taskset, task, pc, pending; int image; } records[8];
+    unsigned count = 0;
+    int matched = 0, cap = 0;
+    static int trace = -1;
+    static unsigned traced;
+#ifdef _WIN32
+    AcquireSRWLockExclusive(&s_sig_lock);
+#else
+    pthread_mutex_lock(&s_sig_lock);
+#endif
+    if (trace < 0) {
+        const char* e = getenv("SPU_TASK_WAKE_TRACE");
+        trace = e && *e && strcmp(e, "0") != 0;
+    }
+    for (spu_signal_waiter* w = s_signal_waiters; w; w = w->next) {
+        if (w->line != line) continue;
+        matched = 1;
+        if (trace && traced < 8) {
+            uint32_t ea = w->taskset + CSTS_SIGNALLED + (w->task / 32u) * 4u;
+            spu_lockline_lock();
+            uint32_t bits = vm_read32(ea);
+            spu_lockline_unlock();
+            records[count].taskset = w->taskset;
+            records[count].task = w->task;
+            records[count].pending = (bits & (0x80000000u >> (w->task % 32u))) != 0;
+            records[count].image = producer->image_id;
+            records[count].pc = producer->pc;
+            ++count;
+            if (++traced == 8) cap = 1;
+        }
+    }
+    if (matched) {
+#ifdef _WIN32
+        WakeAllConditionVariable(&s_sig_cv);
+#else
+        pthread_cond_broadcast(&s_sig_cv);
+#endif
+    }
+#ifdef _WIN32
+    ReleaseSRWLockExclusive(&s_sig_lock);
+#else
+    pthread_mutex_unlock(&s_sig_lock);
+#endif
+    for (unsigned i = 0; i < count; ++i)
+        fprintf(stderr, "[spu-task-wake] image=%d pc=0x%05X cmd=0x%02X line=0x%08X "
+                "taskset=0x%08X task=%u pending_snapshot=%u\n",
+                records[i].image, records[i].pc, command, line,
+                records[i].taskset, records[i].task, records[i].pending);
+    if (cap) fprintf(stderr, "[spu-task-wake] trace_cap=8\n");
+}
