diff --git a/libs/video/rsx_d3d12_feedback.h b/libs/video/rsx_d3d12_feedback.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_d3d12_feedback.h
@@ -0,0 +1,187 @@
+#ifndef RSX_D3D12_FEEDBACK_H
+#define RSX_D3D12_FEEDBACK_H
+
+#include "rsx_d3d12_linear_copy.h"
+
+/* Snapshot IDs follow the stable linear catalog. Only resource is owned;
+ * source is borrowed from that catalog and must remain alive. The caller
+ * waits for the GPU fence before releasing this pool or its source catalog. */
+typedef struct rsx_d3d12_feedback_slot {
+    ID3D12Resource* resource;
+    ID3D12Resource* source;
+    D3D12_RESOURCE_STATES state;
+    uint32_t width, height;
+    DXGI_FORMAT format;
+} rsx_d3d12_feedback_slot;
+
+typedef struct rsx_d3d12_feedback_context {
+    ID3D12Device* device;
+    ID3D12GraphicsCommandList* command_list;
+    rsx_d3d12_feedback_slot slots[32];
+    HRESULT last_hr;
+    const char* last_error;
+} rsx_d3d12_feedback_context;
+
+static inline int rsx_d3d12_feedback_fail(rsx_d3d12_feedback_context* context,
+        HRESULT hr, const char* stage)
+{
+    if (context) {
+        context->last_hr = hr;
+        context->last_error = stage;
+    }
+    return 0;
+}
+
+/* CopyResource copies the complete subresource. Refuse geometry whose actual
+ * allocation would require regions, mip/array handling, or an MSAA resolve. */
+static inline int rsx_d3d12_feedback_source_valid(
+        const rsx_d3d12_linear_resource* source)
+{
+    if (!source || !source->resource || !source->state ||
+            !rsx_linear_view_valid(&source->view) ||
+            source->view.width > D3D12_REQ_TEXTURE2D_U_OR_V_DIMENSION ||
+            source->view.height > D3D12_REQ_TEXTURE2D_U_OR_V_DIMENSION ||
+            source->view.format_id != 0x85 || source->view.bytes_per_pixel != 4 ||
+            source->format != DXGI_FORMAT_R8G8B8A8_UNORM) return 0;
+    D3D12_RESOURCE_DESC desc;
+    source->resource->lpVtbl->GetDesc(source->resource, &desc);
+    return desc.Dimension == D3D12_RESOURCE_DIMENSION_TEXTURE2D &&
+           desc.Width == source->view.width && desc.Height == source->view.height &&
+           desc.DepthOrArraySize == 1 && desc.MipLevels == 1 &&
+           desc.Format == source->format && desc.SampleDesc.Count == 1 &&
+           desc.SampleDesc.Quality == 0;
+}
+
+static inline int rsx_d3d12_feedback_matches(const rsx_d3d12_feedback_slot* slot,
+        const rsx_d3d12_linear_resource* source)
+{
+    return slot->resource && slot->source == source->resource &&
+           slot->resource != source->resource && source->state != &slot->state &&
+           slot->width == source->view.width && slot->height == source->view.height &&
+           slot->format == source->format;
+}
+
+/* Reserve emits no commands. Occupied IDs cannot be replaced or evicted.
+ * Publish only a fully created resource; a failed allocation preserves every
+ * slot and leaves its HRESULT available to the caller's diagnostic. */
+static inline int rsx_d3d12_feedback_reserve(rsx_d3d12_feedback_context* context,
+        uint32_t id, const rsx_d3d12_linear_resource* source)
+{
+    if (!context || !context->device || id >= 32 ||
+            !rsx_d3d12_feedback_source_valid(source))
+        return rsx_d3d12_feedback_fail(context, E_INVALIDARG, "feedback.reserve.input");
+    rsx_d3d12_feedback_slot* slot = &context->slots[id];
+    if (source->state == &slot->state)
+        return rsx_d3d12_feedback_fail(context, E_INVALIDARG, "feedback.reserve.state");
+    if (slot->resource) {
+        if (!rsx_d3d12_feedback_matches(slot, source))
+            return rsx_d3d12_feedback_fail(context, E_INVALIDARG, "feedback.reserve.identity");
+        context->last_hr = S_OK;
+        context->last_error = NULL;
+        return 1;
+    }
+
+    D3D12_HEAP_PROPERTIES heap;
+    D3D12_RESOURCE_DESC desc;
+    memset(&heap, 0, sizeof(heap));
+    memset(&desc, 0, sizeof(desc));
+    heap.Type = D3D12_HEAP_TYPE_DEFAULT;
+    heap.CreationNodeMask = heap.VisibleNodeMask = 1;
+    desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    desc.Width = source->view.width;
+    desc.Height = source->view.height;
+    desc.DepthOrArraySize = desc.MipLevels = 1;
+    desc.Format = source->format;
+    desc.SampleDesc.Count = 1;
+    desc.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+    desc.Flags = D3D12_RESOURCE_FLAG_NONE;
+    ID3D12Resource* resource = NULL;
+#ifdef __cplusplus
+    REFIID iid = IID_ID3D12Resource;
+#else
+    REFIID iid = &IID_ID3D12Resource;
+#endif
+    HRESULT hr = context->device->lpVtbl->CreateCommittedResource(context->device,
+            &heap, D3D12_HEAP_FLAG_NONE, &desc, D3D12_RESOURCE_STATE_COPY_DEST,
+            NULL, iid, (void**)&resource);
+    if (FAILED(hr) || !resource) {
+        if (resource) resource->lpVtbl->Release(resource);
+        return rsx_d3d12_feedback_fail(context, FAILED(hr) ? hr : E_FAIL,
+                "feedback.reserve.create");
+    }
+    slot->resource = resource;
+    slot->source = source->resource;
+    slot->state = D3D12_RESOURCE_STATE_COPY_DEST;
+    slot->width = source->view.width;
+    slot->height = source->view.height;
+    slot->format = source->format;
+    context->last_hr = S_OK;
+    context->last_error = NULL;
+    return 1;
+}
+
+/* Refresh before every feedback draw, including consecutive draws of one ID.
+ * Validate before the first command. The source tracker remains COPY_SOURCE;
+ * replay restores destination/read states after all snapshots are refreshed.
+ * Discard the whole pending command list on any later recording failure. */
+static inline int rsx_d3d12_feedback_snapshot(rsx_d3d12_feedback_context* context,
+        uint32_t id, const rsx_d3d12_linear_resource* source)
+{
+    if (!context || !context->command_list || id >= 32 ||
+            !rsx_d3d12_feedback_source_valid(source))
+        return rsx_d3d12_feedback_fail(context, E_INVALIDARG, "feedback.snapshot.input");
+    rsx_d3d12_feedback_slot* slot = &context->slots[id];
+    if (!rsx_d3d12_feedback_matches(slot, source))
+        return rsx_d3d12_feedback_fail(context, E_INVALIDARG, "feedback.snapshot.identity");
+
+    D3D12_RESOURCE_BARRIER barriers[2];
+    UINT count = 0;
+    memset(barriers, 0, sizeof(barriers));
+    if (*source->state != D3D12_RESOURCE_STATE_COPY_SOURCE) {
+        D3D12_RESOURCE_BARRIER* barrier = &barriers[count++];
+        barrier->Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        barrier->Transition.pResource = source->resource;
+        barrier->Transition.StateBefore = *source->state;
+        barrier->Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+        barrier->Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    }
+    if (slot->state != D3D12_RESOURCE_STATE_COPY_DEST) {
+        D3D12_RESOURCE_BARRIER* barrier = &barriers[count++];
+        barrier->Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        barrier->Transition.pResource = slot->resource;
+        barrier->Transition.StateBefore = slot->state;
+        barrier->Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_DEST;
+        barrier->Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    }
+    if (count) context->command_list->lpVtbl->ResourceBarrier(context->command_list, count, barriers);
+    *source->state = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    slot->state = D3D12_RESOURCE_STATE_COPY_DEST;
+    context->command_list->lpVtbl->CopyResource(context->command_list,
+            slot->resource, source->resource);
+
+    memset(&barriers[0], 0, sizeof(barriers[0]));
+    barriers[0].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    barriers[0].Transition.pResource = slot->resource;
+    barriers[0].Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+    barriers[0].Transition.StateAfter = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    barriers[0].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    context->command_list->lpVtbl->ResourceBarrier(context->command_list, 1, barriers);
+    slot->state = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    context->last_hr = S_OK;
+    context->last_error = NULL;
+    return 1;
+}
+
+/* The caller guarantees fence completion. Source identities are borrowed;
+ * keep context configuration and any failure diagnostic for reuse/reporting. */
+static inline void rsx_d3d12_feedback_release(rsx_d3d12_feedback_context* context)
+{
+    if (!context) return;
+    for (uint32_t id = 0; id < 32; ++id) {
+        if (context->slots[id].resource)
+            context->slots[id].resource->lpVtbl->Release(context->slots[id].resource);
+        memset(&context->slots[id], 0, sizeof(context->slots[id]));
+    }
+}
+
+#endif
