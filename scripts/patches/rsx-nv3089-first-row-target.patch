+/* Whether the requested source byte falls inside the surface's FIRST row.
+ *
+ * This mirrors the selection rule the public macOS reference uses before it
+ * writes a rendered target back into guest memory, and the reason is recorded
+ * there: a looser containment predicate let a phantom 1280x720 target at
+ * offset 0 claim a request addressed to a later allocation, and the write-back
+ * then overwrote VRAM from 0 instead of the requested surface. Only the first
+ * row can identify a producer; a request that lands on a later row is not a
+ * match, however well it is contained. */
+static inline int cellGcmTransferProbeFirstRow(u32 location, u32 offset,
+        u32 surface_location, u32 surface_offset, u32 surface_pitch, u32 surface_width)
+{
+    if (!surface_pitch || !surface_width) return 0;
+    if (location != surface_location || offset < surface_offset) return 0;
+    const u32 delta = offset - surface_offset;
+    if (delta >= surface_pitch) return 0;          /* first row only */
+    if (delta & 3u) return 0;                      /* 32-bit pixel grid */
+    return (u64)delta < (u64)surface_width * 4;    /* inside the row's pixels */
+}
