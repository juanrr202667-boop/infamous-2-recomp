+/* Read-only selection of the NEWEST offscreen view whose first row contains
+ * the requested source byte. This is the rule the public macOS reference uses
+ * before its write-back, kept here as metadata: no submit, no wait, no map and
+ * no guest write. A view with no resource or no epoch cannot win. */
+static int d3d12_transfer_probe_target(u32 location, u32 offset, u32 pitch,
+        cellGcmTransferProbeTarget* out)
+{
+    u64 newest = 0;
+    int found = 0;
+    if (!out) return 0;
+    for (u32 i = 0; i < s_off_rt_count && i < MAX_OFF_RTS; ++i) {
+        const rsx_linear_version* view = &s_off_rt_views[i];
+        if (!s_d3d.off_rt[i].res || view->view.offset > UINT32_MAX) continue;
+        if (!cellGcmTransferProbeFirstRow(location, offset, view->view.location,
+                (u32)view->view.offset, view->view.pitch, view->view.width)) continue;
+        if (found && view->complete_at <= newest) continue;
+        newest = view->complete_at;
+        found = 1;
+        out->location = view->view.location;
+        out->offset = (u32)view->view.offset;
+        out->pitch = view->view.pitch;
+        out->width = view->view.width;
+        out->height = view->view.height;
+        out->epoch = view->complete_at;
+        out->argb8 = (s_d3d.off_rt[i].dxgi == DXGI_FORMAT_R8G8B8A8_UNORM) ? 1u : 0u;
+    }
+    return found;
+}
