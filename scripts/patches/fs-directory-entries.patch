+/* CellFsDirectoryEntry: packed 52-byte stat, 2 dirent bytes, name[256],
+ * then 2 bytes of tail padding for 4-byte alignment: 312 (0x138) bytes.
+ * Unlike Readdir's u64 byte count, GetDirectoryEntries writes a u32 ENTRY
+ * count. BCUS98125 puts its live fd immediately after that count. */
+static void cellFsGetDirectoryEntries(ppu_context* ctx)
+{
+    constexpr uint32_t stride = 52 + 2 + 256 + 2;
+    static_assert(stride == 312);
+    int fd = (int)(uint32_t)ctx->gpr[3];
+    uint64_t entries = ctx->gpr[4], length = ctx->gpr[5], count_ptr = ctx->gpr[6];
+    uint64_t limit = ppu_vm_size ? ppu_vm_size : 0x100000000ull;
+    // Reject before readdir: bad arguments must not consume the directory.
+    if (fd < 0 || fd >= FS_MAX || !g_dirs[fd]) {
+        ctx->gpr[3] = (uint64_t)(int64_t)(int32_t)CELL_EBADF; return;
+    }
+    if (length < stride || length > UINT32_MAX) {
+        ctx->gpr[3] = (uint64_t)(int64_t)(int32_t)CELL_EINVAL; return;
+    }
+    if (!entries || !count_ptr || entries > UINT32_MAX || count_ptr > UINT32_MAX ||
+        entries + length > limit || count_ptr + 4 > limit) {
+        ctx->gpr[3] = (uint64_t)(int64_t)(int32_t)CELL_EFAULT; return;
+    }
+    uint32_t count = 0;
+    for (; count < length / stride; ++count) {
+        struct dirent* e = readdir(g_dirs[fd]);
+        if (!e) break;
+        char full[1300]; struct stat st;
+        snprintf(full, sizeof full, "%s/%s", g_dir_path[fd], e->d_name);
+        if (stat(full, &st)) {
+            ctx->gpr[3] = (uint64_t)(int64_t)CELL_FS_EIO; return;
+        }
+        bool directory = (st.st_mode & S_IFDIR) != 0;
+        uint32_t destination = (uint32_t)entries + count * stride;
+        memset(vm_base + destination, 0, stride);
+        write_stat(destination, directory ? (CELL_FS_S_IFDIR | 0x1FF)
+                                          : (CELL_FS_S_IFREG | 0x1B6), (uint64_t)st.st_size);
+        vm_write64(destination + 0x0C, (uint64_t)st.st_atime);
+        vm_write64(destination + 0x14, (uint64_t)st.st_mtime);
+        vm_write64(destination + 0x1C, (uint64_t)st.st_ctime);
+        size_t nl = strlen(e->d_name); if (nl > 255) nl = 255;
+        vm_base[destination + 52] = directory ? CELL_FS_TYPE_DIR : CELL_FS_TYPE_REG;
+        vm_base[destination + 53] = (uint8_t)nl;
+        memcpy(vm_base + destination + 54, e->d_name, nl);
+    }
+    vm_write32(count_ptr, count);
+    ctx->gpr[3] = CELL_OK;
+}
