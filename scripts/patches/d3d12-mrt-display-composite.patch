+/* Check whether a draw operation targets a registered display buffer,
+ * either directly (rt_off == 0 or cellGcmOffsetIsDisplay(rt_off)),
+ * or via MRT (any rt_mrt[m] matching a display buffer).
+ * Returns 1 if display content, 0 if offscreen-only or clear. */
+static inline int rsx_d3d12_draw_targets_display(u32 rt_off, const u32 rt_mrt[3], int is_clear)
+{
+    if (is_clear) return 0;
+    if (rt_off == 0) return 1;
+    extern int cellGcmOffsetIsDisplay(u32 offset);
+    if (cellGcmOffsetIsDisplay(rt_off)) return 1;
+    if (rt_mrt) {
+        for (int m = 0; m < 3; m++) {
+            if (rt_mrt[m] && cellGcmOffsetIsDisplay(rt_mrt[m]))
+                return 1;
+        }
+    }
+    return 0;
+}
