+/* DWORD0 bit 21 on a fetch opcode: EXP_TEX, the _bx2 modifier. The texture
+ * unit field ends at bit 20, so the bit is free on fetches. The sample then
+ * returns x*2-1 on every lane (RPCS3 FragmentProgramDecompiler, _process_texel;
+ * the same rule the upstream ps3recomp applies from every entry point). */
+#define FP_TEX_EXP_TEX      (1u << 21)
