+static void temporal_abort(u32 draw, int unit, const char* reason)
+{
+    fprintf(stderr, "[TEMPORAL_FATAL] frame=%llu op=%u unit=%d reason=%s\n",
+        (unsigned long long)s_d3d.frame_count, draw, unit, reason ? reason : "unknown");
+    if (draw < s_d3d.draw_count && draw < MAX_DRAWS) {
+        const D3D12DrawRecord* dr = &s_d3d.draws[draw];
+        fprintf(stderr, "[TEMPORAL_FATAL] rt=0x%08X mrt=0x%X/0x%X/0x%X size=%ux%u fmt=0x%X "
+            "dma_seen=0x%X dma=0x%X/0x%X/0x%X/0x%X clear=0x%X fp=0x%X mask=0x%X\n",
+            dr->rt_off, dr->rt_mrt[0], dr->rt_mrt[1], dr->rt_mrt[2], dr->rt_w, dr->rt_h,
+            dr->rt_fmt, dr->surface_meta.dma_seen, dr->surface_meta.color_dma[0],
+            dr->surface_meta.color_dma[1], dr->surface_meta.color_dma[2],
+            dr->surface_meta.color_dma[3], dr->surface_meta.clear_flags,
+            dr->fp_addr, s_rt_plan[draw].texture_mask);
+        if (unit >= 0 && unit < 16)
+            fprintf(stderr, "[TEMPORAL_FATAL] tex[%d] raw=0x%X size=%ux%u format=0x%X ctrl3=0x%X\n",
+                unit, dr->tex[unit].raw, dr->tex[unit].w, dr->tex[unit].h,
+                dr->tex[unit].format_word, dr->tex[unit].ctrl3);
+    }
+    fflush(stderr); fflush(stdout);
+    /* No partial command list is submitted or reused after a failed plan. */
+    ExitProcess(2);
+}
