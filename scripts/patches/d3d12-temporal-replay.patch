+static void temporal_release_completed_resources(void)
+{
+    for (u32 d = 0; d < MAX_DRAWS; ++d) {
+        if (s_temporal_pso[d]) {
+            s_temporal_pso[d]->lpVtbl->Release(s_temporal_pso[d]);
+            s_temporal_pso[d] = NULL;
+        }
+    }
+    for (u32 i = 0; i < s_off_rt_count; ++i) {
+        if (s_d3d.off_rt[i].up) {
+            s_d3d.off_rt[i].up->lpVtbl->Release(s_d3d.off_rt[i].up);
+            s_d3d.off_rt[i].up = NULL;
+        }
+    }
+}
