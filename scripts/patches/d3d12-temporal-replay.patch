+#ifndef RSX_D3D12_TEMPORAL_REPLAY_H
+#define RSX_D3D12_TEMPORAL_REPLAY_H
+
+#include "rsx_linear_coherence.h"
+#include "rsx_d3d12_linear_copy.h"
+
+/* Lexical backend adapter, after the stable record planner and transition
+ * helper. Only pending watermarks change while recording. The caller must
+ * discard the whole command list on failure and call commit only after its
+ * fence completed successfully. Resources and seeds outlive that fence. */
+static void temporal_validate_record(u32 draw)
+{
+    if (!s_temporal_pending || draw >= s_d3d.draw_count || draw >= MAX_DRAWS ||
+            s_off_rt_count > MAX_OFF_RTS || s_pending_rt_epoch == UINT64_MAX)
+        temporal_abort(draw, -1, "invalid pending temporal record");
+    if (s_rt_plan[draw].texture_mask & ~0xFFFFu)
+        temporal_abort(draw, -1, "unknown temporal shader mask");
+    for (u32 i = 0; i < s_off_rt_count; ++i) {
+        if (!rsx_linear_view_valid(&s_pending_rt_views[i].view) ||
+                s_pending_rt_views[i].complete_at > s_pending_rt_epoch ||
+                !s_d3d.off_rt[i].res ||
+                s_d3d.off_rt[i].dxgi != DXGI_FORMAT_R8G8B8A8_UNORM)
+            temporal_abort(draw, -1, "invalid temporal resource catalog");
+    }
+    for (int i = 0; i < 4; ++i) {
+        int slot = s_rt_plan[draw].target[i];
+        if (slot < -1 || (slot >= 0 && (u32)slot >= s_off_rt_count))
+            temporal_abort(draw, -1, "invalid temporal destination identity");
+    }
+    for (int unit = 0; unit < 16; ++unit) {
+        if (!(s_rt_plan[draw].texture_mask & (1u << unit))) continue;
+        int slot = s_d3d.draws[draw].tex_rt[unit];
+        if (slot < -1 || (slot >= 0 && (u32)slot >= s_off_rt_count))
+            temporal_abort(draw, unit, "invalid temporal source identity");
+    }
+}
+
+static int temporal_validate_span(void* user, u32 src, u32 dst,
+        const rsx_linear_copy_span* span)
+{
+    return rsx_d3d12_linear_copy_valid(user, src, dst, span);
+}
+
+static int temporal_emit_span(void* user, u32 src, u32 dst,
+        const rsx_linear_copy_span* span)
+{
+    if (!rsx_d3d12_linear_copy_emit(user, src, dst, span)) return 0;
+    s_d3d.off_rt[src].used = s_d3d.off_rt[dst].used = 1;
+    return 1;
+}
+
+static void temporal_materialize(int slot, u32 draw)
+{
+    if (slot < 0) return;
+    if (!s_temporal_pending || (u32)slot >= s_off_rt_count || s_off_rt_count > MAX_OFF_RTS)
+        temporal_abort(draw, -1, "invalid materialization identity");
+    rsx_d3d12_linear_resource resources[MAX_OFF_RTS];
+    for (u32 i = 0; i < s_off_rt_count; ++i) {
+        resources[i].resource = s_d3d.off_rt[i].res;
+        resources[i].state = &s_d3d.off_rt[i].st;
+        resources[i].view = s_pending_rt_views[i].view;
+        resources[i].format = (DXGI_FORMAT)s_d3d.off_rt[i].dxgi;
+    }
+    rsx_d3d12_linear_copy_context context = {s_d3d.cmd_list, resources, s_off_rt_count};
+    /* Validate the complete copy plan before its first barrier or copy. The
+     * catalog is unchanged between this pass and emission. */
+    int result = rsx_linear_plan_materialize(s_pending_rt_views, s_off_rt_count,
+        (u32)slot, s_pending_rt_epoch, temporal_validate_span, &context);
+    if (result != RSX_LINEAR_OK)
+        temporal_abort(draw, -1, "temporal copy plan validation failed");
+    result = rsx_linear_plan_materialize(s_pending_rt_views, s_off_rt_count,
+        (u32)slot, s_pending_rt_epoch, temporal_emit_span, &context);
+    if (result != RSX_LINEAR_OK)
+        temporal_abort(draw, -1, "temporal copy emission failed; discard command list");
+    s_pending_rt_views[slot].complete_at = s_pending_rt_epoch;
+    s_d3d.off_rt[slot].used = 1;
+}
+
+static void temporal_before_op(u32 draw)
+{
+    temporal_validate_record(draw);
+    /* Reconcile every input before restoring states. A later reconciliation
+     * may use a previously reconciled view as COPY_SOURCE. */
+    for (int unit = 0; unit < 16; ++unit)
+        if (s_rt_plan[draw].texture_mask & (1u << unit))
+            temporal_materialize(s_d3d.draws[draw].tex_rt[unit], draw);
+    for (int member = 0; member < 4; ++member)
+        temporal_materialize(s_rt_plan[draw].target[member], draw);
+    for (int unit = 0; unit < 16; ++unit) {
+        if (!(s_rt_plan[draw].texture_mask & (1u << unit))) continue;
+        int slot = s_d3d.draws[draw].tex_rt[unit];
+        if (slot >= 0) off_rt_transition(slot, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+    }
+    for (int member = 0; member < 4; ++member) {
+        int slot = s_rt_plan[draw].target[member];
+        if (slot >= 0) off_rt_transition(slot, D3D12_RESOURCE_STATE_RENDER_TARGET);
+    }
+}
+
+static void temporal_after_op(u32 draw)
+{
+    temporal_validate_record(draw);
+    ++s_pending_rt_epoch;
+    for (int member = 0; member < 4; ++member) {
+        int slot = s_rt_plan[draw].target[member];
+        if (slot >= 0) s_pending_rt_views[slot].complete_at = s_pending_rt_epoch;
+    }
+}
+
+static void temporal_commit(void)
+{
+    if (!s_temporal_pending || s_off_rt_count > MAX_OFF_RTS)
+        temporal_abort(UINT32_MAX, -1, "invalid temporal commit");
+    memcpy(s_off_rt_views, s_pending_rt_views,
+        (size_t)s_off_rt_count * sizeof(s_off_rt_views[0]));
+    s_off_rt_epoch = s_pending_rt_epoch;
+    s_temporal_pending = 0;
+}
+
+#endif
