+static ID3D12PipelineState* temporal_select_pipeline(u32 draw, const D3D12DrawRecord* dr, u32* mask)
+{
+    ID3D12PipelineState* pipeline = dr->fp_addr ? vp_get_fp_pso(dr->vs_idx,
+        dr->fp_addr, dr->blend_key, dr_num_rts(dr),
+        dr->rt_off ? rsx_surface_dxgi(dr->rt_fmt) : DXGI_FORMAT_R8G8B8A8_UNORM,
+        dr->fp_exp32, dr->cmask, dr->cull, dr_cube_mask(dr), dr->depth_key) : NULL;
+    if (pipeline) {
+        for (u32 i = 0; i < s_d3d.vp_fp_n; ++i)
+            if (s_d3d.vp_fp[i].pso == pipeline) {
+                *mask = s_d3d.vp_fp[i].texture_mask;
+                return pipeline;
+            }
+        *mask = UINT32_MAX;
+        return pipeline;
+    }
+    pipeline = (s_d3d.tex_ready && s_d3d.pipeline_state_vp) ?
+        s_d3d.pipeline_state_vp : s_d3d.pipeline_state_vp_color;
+    if (!pipeline) pipeline = s_d3d.pipeline_state_vp;
+    /* compile_vp creates fixed PSOs: RGBA8, one RT, all color channels,
+     * depth enabled/write/LEQUAL, no blend or cull. Reusing those PSOs for
+     * other captured state would silently change the guest operation. */
+    if (pipeline) {
+        if ((dr->cmask & 0xFu) != 0xFu)
+            temporal_abort(draw, -1, "fixed fallback incompatible: color write mask");
+        if ((dr->depth_key & 3u) != 3u ||
+                gcm_depth_func_d3d((dr->depth_key >> 2) & 0xFFFFu) != D3D12_COMPARISON_FUNC_LESS_EQUAL)
+            temporal_abort(draw, -1, "fixed fallback incompatible: depth state");
+        if ((dr->rt_fmt & 0x1Fu) != 8u)
+            temporal_abort(draw, -1, "fixed fallback incompatible: color format");
+        /* The selector enables MRT members even when their guest offset is 0. */
+        if (!dr->surface_meta.valid ||
+                (dr->surface_meta.color_target != CELL_GCM_SURFACE_TARGET_0 &&
+                 dr->surface_meta.color_target != CELL_GCM_SURFACE_TARGET_1))
+            temporal_abort(draw, -1, "fixed fallback incompatible: color target selection");
+        if (dr->rt_mrt[0] || dr->rt_mrt[1] || dr->rt_mrt[2])
+            temporal_abort(draw, -1, "fixed fallback incompatible: multiple color targets");
+        if (dr->blend_key & 1u)
+            temporal_abort(draw, -1, "fixed fallback incompatible: blending");
+        if (dr->cull & 1u)
+            temporal_abort(draw, -1, "fixed fallback incompatible: culling");
+        if (pipeline == s_d3d.pipeline_state_vp && dr->tex[0].set && dr->tex[0].cube)
+            temporal_abort(draw, -1, "fixed fallback incompatible: cube texture");
+    }
+    /* These are the actual compiled fallback programs: t0 coverage/discard
+     * for the atlas, no texture references for the color-only program. */
+    *mask = pipeline == s_d3d.pipeline_state_vp ? 1u : 0u;
+    return pipeline;
+}
