+static D3D12_RECT temporal_clear_rect(const D3D12DrawRecord* dr, u32 width, u32 height)
+{
+    const rsx_d3d12_surface_metadata* m = &dr->surface_meta;
+    D3D12_RECT rect = {0, 0, (LONG)width, (LONG)height};
+    if (!m->valid) return rect;
+    u64 left = m->clip_x > m->scissor_x ? m->clip_x : m->scissor_x;
+    u64 top = m->clip_y > m->scissor_y ? m->clip_y : m->scissor_y;
+    u64 right = (u64)m->clip_x + m->clip_w;
+    u64 bottom = (u64)m->clip_y + m->clip_h;
+    const u64 scissor_right = (u64)m->scissor_x + m->scissor_w;
+    const u64 scissor_bottom = (u64)m->scissor_y + m->scissor_h;
+    if (right > scissor_right) right = scissor_right;
+    if (bottom > scissor_bottom) bottom = scissor_bottom;
+    if (right > width) right = width;
+    if (bottom > height) bottom = height;
+    if (left > right) left = right;
+    if (top > bottom) top = bottom;
+    rect.left = (LONG)left; rect.top = (LONG)top;
+    rect.right = (LONG)right; rect.bottom = (LONG)bottom;
+    return rect;
 }
 
