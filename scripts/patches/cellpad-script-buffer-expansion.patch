diff --git a/libs/input/cellPad.c b/libs/input/cellPad.c
index f2b4c11..0948ad6 100644
--- a/libs/input/cellPad.c
+++ b/libs/input/cellPad.c
@@ -618,7 +618,8 @@ skip_inject: ;
      * LEFT 0x0080, RIGHT 0x0020, CROSS 0x4000, CIRCLE 0x2000, TRIANGLE 0x1000.
      * Legit input simulation on the same footing as PAD_AUTOPRESS/PAD_STICK. */
     { static int s_sc = -1;
-      static struct { double t; unsigned mask; } ev[32]; static int n_ev = 0;
+#define PAD_SCRIPT_MAX 256
+      static struct { double t; unsigned mask; } ev[PAD_SCRIPT_MAX]; static int n_ev = 0;
       static unsigned long long t0 = 0;   /* not ULONGLONG: this builds on POSIX too */
       if (s_sc < 0) {
           s_sc = 0;
@@ -626,7 +627,7 @@ skip_inject: ;
           if (e && *e) {
               s_sc = 1; t0 = GetTickCount64();
               const char* p = e;
