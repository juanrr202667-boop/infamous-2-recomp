+/* AUDIO_AMPLITUDE_STATS=1 observes the actual consumed samples and the mix
+ * before the host clamp. Counts are scalar samples, not frames. Reporting
+ * every 938 mixed blocks bounds logging (~5 seconds at 48 kHz); this is an
+ * audio-time window, not a claim about device playback or wall-clock pace.
+ * State is owned by the mixer thread. No PCM or gain is changed here. */
+typedef struct {
+    u64 count, finite, nonfinite, rails, over;
+    double sum, squares, peak;
+} AudioAmplitudeStats;
+static struct {
+    int initialized, enabled;
+    unsigned blocks;
+    AudioAmplitudeStats source[CELL_AUDIO_PORT_MAX];
+    AudioAmplitudeStats contribution[CELL_AUDIO_PORT_MAX];
+    AudioAmplitudeStats mix;
+} s_amplitude_stats;
+
+static void audio_amplitude_sample(AudioAmplitudeStats* stats, float sample)
+{
+    stats->count++;
+    if (!isfinite(sample)) { stats->nonfinite++; return; }
+    const double value = sample, magnitude = fabs(value);
+    stats->finite++;
+    stats->sum += value;
+    stats->squares += value * value;
+    if (magnitude > stats->peak) stats->peak = magnitude;
+    if (magnitude == 1.0) stats->rails++;
+    if (magnitude > 1.0) stats->over++;
+}
+
+static void audio_amplitude_report(const char* stage, int port, AudioAmplitudeStats* stats)
+{
+    if (!stats->count) return;
+    fprintf(stderr, "[audio-amplitude] stage=%s port=%d samples=%llu finite=%llu nonfinite=%llu "
+            "rails=%llu over=%llu peak=%.9g mean=%.9g rms=%.9g blocks=%u (before-host-clamp)\n",
+            stage, port, (unsigned long long)stats->count, (unsigned long long)stats->finite,
+            (unsigned long long)stats->nonfinite, (unsigned long long)stats->rails,
+            (unsigned long long)stats->over, stats->peak,
+            stats->finite ? stats->sum / stats->finite : 0.0,
+            stats->finite ? sqrt(stats->squares / stats->finite) : 0.0,
+            s_amplitude_stats.blocks);
+    memset(stats, 0, sizeof(*stats));
+}
+
