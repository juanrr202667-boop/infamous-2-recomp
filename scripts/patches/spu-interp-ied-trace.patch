 /* Channel ABI (runtime/spu/spu_channels.c); the lifter emits these same protos
  * into each generated spu_recomp.h — declared here to stay header-independent. */
@@ -106,6 +111,37 @@
 #define I   (d.imm)
 #define PREF(r) ((r)._u32[0])
 
+/* Optional, bounded E/D diagnostic. Never modifies the guest context. */
+static void i2_trace_interpreted_ied(const spu_context* ctx, uint32_t pc,
+                                     spu_op op, uint32_t bits, int taken,
+                                     int before, int after) {
+    static _Atomic unsigned emitted = 0;
+    const int saved_errno = errno;
+#ifdef _WIN32
+    const DWORD saved_error = GetLastError();
+#endif
+    const char* enabled = getenv("I2_INTERP_IRQ_TRACE");
+    if (enabled && enabled[0] == '1' && enabled[1] == 0) {
+        const char* filter = getenv("I2_INTERP_IRQ_IMAGE");
+        char* end = NULL;
+        long image = filter && *filter ? strtol(filter, &end, 0) : 0;
+        int match = !filter || !*filter || (end && *end == 0 && image == ctx->image_id);
+        const char* value = getenv("I2_INTERP_IRQ_TRACE_MAX");
+        unsigned long limit = value && *value ? strtoul(value, &end, 10) : 128;
+        if (value && *value && (!end || *end || !limit || limit > 4096)) limit = 0;
+        if (match && limit && atomic_fetch_add_explicit(&emitted, 1, memory_order_relaxed) < limit) {
+            fprintf(stderr, "[i2-spu-ied] image=%d spu=%u policy=%d pc=%05X op=%s bits=%05X taken=%d before=%d after=%d\n",
+                    ctx->image_id, ctx->spu_id, ctx->policy_mode, pc,
+                    spu_op_name[op], bits, taken, before, after);
+            fflush(stderr);
+        }
+    }
+    errno = saved_errno;
+#ifdef _WIN32
+    SetLastError(saved_error);
+#endif
+}
+
 static int spu_step(spu_context* ctx) {
