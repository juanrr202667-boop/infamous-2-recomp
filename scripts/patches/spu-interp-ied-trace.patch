@@ -113,6 +149,18 @@
                   | ((uint32_t)p[m+2] << 8) | p[m+3];
     spu_ins d; spu_decode1(insn, pc, &d);
     uint32_t next = pc + 4;
+    int ied_taken = -1;
+    int ied_before = ctx->int_enable;
+    if (insn & 0xC0000u) {
+        switch (d.op) {
+        case SPU_bi: case SPU_bisl: case SPU_iret: ied_taken = 1; break;
+        case SPU_biz:   ied_taken = PREF(DST) == 0; break;
+        case SPU_binz:  ied_taken = PREF(DST) != 0; break;
+        case SPU_bihz:  ied_taken = (PREF(DST) & 0xffffu) == 0; break;
+        case SPU_bihnz: ied_taken = (PREF(DST) & 0xffffu) != 0; break;
+        default: break;
+        }
+    }
 
     switch (d.op) {
     /* immediates / loads */
@@ -314,6 +362,9 @@
                 d.op < SPU_OP_COUNT ? spu_op_name[d.op] : "?", insn, pc);
         ctx->pc = pc; ctx->status = SPU_STATUS_STOPPED_BY_HALT; return 1;
     }
+    if (ied_taken >= 0)
+        i2_trace_interpreted_ied(ctx, pc, d.op, insn & 0xC0000u,
+                                 ied_taken, ied_before, ctx->int_enable);
     ctx->pc = next;
     return 0;
 }
