+/* AltiVec estimates use guest VSCR.NJ, independently of a foreign caller's
+ * FTZ/DAZ or rounding mode. Restore host status/control after each vector. */
+#if defined(_M_X64) || defined(__x86_64__)
+#include <xmmintrin.h>
+typedef unsigned ppu_vmx_fp_env;
+static inline ppu_vmx_fp_env ppu_vmx_fp_begin(void) {
+    unsigned saved = _mm_getcsr();
+    _mm_setcsr(0x1F80u); /* nearest, gradual underflow, masked exceptions */
+    return saved;
+}
+static inline void ppu_vmx_fp_end(ppu_vmx_fp_env saved) { _mm_setcsr(saved); }
+#else
+typedef fenv_t ppu_vmx_fp_env;
+static inline ppu_vmx_fp_env ppu_vmx_fp_begin(void) {
+    fenv_t saved;
+    fegetenv(&saved);
+    fesetenv(FE_DFL_ENV);
+    return saved;
+}
+static inline void ppu_vmx_fp_end(ppu_vmx_fp_env saved) { fesetenv(&saved); }
+#endif
 
