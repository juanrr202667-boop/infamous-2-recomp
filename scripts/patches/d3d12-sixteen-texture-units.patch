+#ifndef RSX_D3D12_GUEST_PIPELINE_H
+#define RSX_D3D12_GUEST_PIPELINE_H
+
+#include <d3d12.h>
+#include <d3dcompiler.h>
+#include <string.h>
+#include "rsx_commands.h"
+
+/* Keep cache SRVs, RT SRVs and per-draw tables in disjoint heap windows. */
+#define RSX_D3D12_GUEST_TEXTURE_UNITS RSX_MAX_TEXTURES
+#define RSX_D3D12_DRAW_SRV_BASE 128
+#define RSX_D3D12_VP_TEX_SLOTS 96
+#define RSX_D3D12_VP_TEX_SRV_BASE 1
+#define RSX_D3D12_MAX_OFF_RTS 16
+#define RSX_D3D12_RT_SRV_BASE (RSX_D3D12_VP_TEX_SRV_BASE + RSX_D3D12_VP_TEX_SLOTS)
+
+/* The legacy FP buffer keeps one scale per texture, then alpha and constants.
+ * The current unbuffered decompiler does not consume this buffer. */
+#define RSX_D3D12_FP_CONSTANT_COUNT 64
+#define RSX_D3D12_FP_ALPHA_FLOAT_OFFSET (RSX_D3D12_GUEST_TEXTURE_UNITS * 4)
+#define RSX_D3D12_FP_CONSTANT_FLOAT_OFFSET (RSX_D3D12_FP_ALPHA_FLOAT_OFFSET + 4)
+#define RSX_D3D12_FPCB_STRIDE (((RSX_D3D12_GUEST_TEXTURE_UNITS + 1 + RSX_D3D12_FP_CONSTANT_COUNT) * 16 + 255) & ~255)
+
+static inline UINT rsx_d3d12_guest_draw_srv_index(UINT draw, UINT unit)
+{
+    return RSX_D3D12_DRAW_SRV_BASE + draw * RSX_D3D12_GUEST_TEXTURE_UNITS + unit;
+}
+
+/* This is the VP/guest fragment-program signature. The legacy atlas uses its
+ * separate one-texture signature. Serialization consumes all local descriptors
+ * before this function returns. */
+static inline HRESULT rsx_d3d12_create_guest_root_signature(
+    ID3D12Device* device, ID3D12RootSignature** root, ID3DBlob** errors)
+{
+    D3D12_DESCRIPTOR_RANGE range;
+    D3D12_ROOT_PARAMETER parameters[3];
+    D3D12_STATIC_SAMPLER_DESC samplers[RSX_D3D12_GUEST_TEXTURE_UNITS];
+    D3D12_ROOT_SIGNATURE_DESC description;
+    ID3DBlob* signature = NULL;
+    ID3DBlob* local_errors = NULL;
+    HRESULT result;
+    memset(&range, 0, sizeof(range));
+    memset(parameters, 0, sizeof(parameters));
+    memset(samplers, 0, sizeof(samplers));
+    memset(&description, 0, sizeof(description));
+    *root = NULL;
+    if (errors) *errors = NULL;
+    range.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+    range.NumDescriptors = RSX_D3D12_GUEST_TEXTURE_UNITS;
+    range.BaseShaderRegister = 0;
+    range.OffsetInDescriptorsFromTableStart = D3D12_DESCRIPTOR_RANGE_OFFSET_APPEND;
+    parameters[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_CBV;
+    parameters[0].Descriptor.ShaderRegister = 0;
+    parameters[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_VERTEX;
+    parameters[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    parameters[1].DescriptorTable.NumDescriptorRanges = 1;
+    parameters[1].DescriptorTable.pDescriptorRanges = &range;
+    parameters[1].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    parameters[2].ParameterType = D3D12_ROOT_PARAMETER_TYPE_CBV;
+    parameters[2].Descriptor.ShaderRegister = 1;
+    parameters[2].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    for (UINT unit = 0; unit < RSX_D3D12_GUEST_TEXTURE_UNITS; unit++) {
+        samplers[unit].Filter = D3D12_FILTER_MIN_MAG_MIP_LINEAR;
+        samplers[unit].AddressU = samplers[unit].AddressV = samplers[unit].AddressW = D3D12_TEXTURE_ADDRESS_MODE_WRAP;
+        samplers[unit].ShaderRegister = unit;
+        samplers[unit].MaxLOD = D3D12_FLOAT32_MAX;
+        samplers[unit].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    }
+    samplers[0].Filter = D3D12_FILTER_MIN_MAG_MIP_POINT;
+    samplers[0].AddressU = samplers[0].AddressV = samplers[0].AddressW = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+    description.NumParameters = 3;
+    description.pParameters = parameters;
+    description.NumStaticSamplers = RSX_D3D12_GUEST_TEXTURE_UNITS;
+    description.pStaticSamplers = samplers;
+    description.Flags = D3D12_ROOT_SIGNATURE_FLAG_ALLOW_INPUT_ASSEMBLER_INPUT_LAYOUT;
+    result = D3D12SerializeRootSignature(&description, D3D_ROOT_SIGNATURE_VERSION_1,
+                                        &signature, &local_errors);
+    if (SUCCEEDED(result)) {
+        result = device->lpVtbl->CreateRootSignature(device, 0,
+            signature->lpVtbl->GetBufferPointer(signature), signature->lpVtbl->GetBufferSize(signature),
+#ifdef __cplusplus
+            IID_ID3D12RootSignature, (void**)root);
+#else
+            &IID_ID3D12RootSignature, (void**)root);
+#endif
+    }
+    if (signature) signature->lpVtbl->Release(signature);
+    if (errors) *errors = local_errors;
+    else if (local_errors) local_errors->lpVtbl->Release(local_errors);
+    return result;
+}
+
+#endif
