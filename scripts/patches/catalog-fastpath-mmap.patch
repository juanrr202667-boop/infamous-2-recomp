+/* ---------------------------------------------------------------------------
+ * Fast-path catalog mapping for infamous1.psarc_s
+ * -----------------------------------------------------------------------*/
+typedef struct sys_fs_mapped_info {
+    const uint8_t* data;
+    uint64_t       size;
+    uint64_t       pos;
+#ifdef _WIN32
+    HANDLE         h_file;
+    HANDLE         h_mapping;
+#else
+    int            is_mmap;
+#endif
+    int            is_mapped;
+} sys_fs_mapped_info;
+
+static sys_fs_mapped_info g_sys_fs_mapped[SYS_FS_FD_MAX];
+
+static int is_sys_fs_fast_catalog_enabled(void)
+{
+    static int s_fast_catalog = -1;
+    if (s_fast_catalog < 0) {
+        const char* e1 = getenv("I2_FAST_CATALOG");
+        const char* e2 = getenv("I2_CATALOG_FASTPATH");
+        s_fast_catalog = ((e1 && atoi(e1) != 0) || (e2 && atoi(e2) != 0)) ? 1 : 0;
+    }
+    return s_fast_catalog;
+}
+
+static void sys_fs_unmap(int slot)
+{
+    if (slot < 0 || slot >= SYS_FS_FD_MAX || !g_sys_fs_mapped[slot].is_mapped) return;
+#ifdef _WIN32
+    if (g_sys_fs_mapped[slot].data) {
+        if (g_sys_fs_mapped[slot].h_mapping != NULL) {
+            UnmapViewOfFile(g_sys_fs_mapped[slot].data);
+        } else {
+            free((void*)g_sys_fs_mapped[slot].data);
+        }
+    }
+    if (g_sys_fs_mapped[slot].h_mapping != NULL) {
+        CloseHandle(g_sys_fs_mapped[slot].h_mapping);
+    }
+    if (g_sys_fs_mapped[slot].h_file != INVALID_HANDLE_VALUE && g_sys_fs_mapped[slot].h_file != NULL) {
+        CloseHandle(g_sys_fs_mapped[slot].h_file);
+    }
+    g_sys_fs_mapped[slot].h_file = INVALID_HANDLE_VALUE;
+    g_sys_fs_mapped[slot].h_mapping = NULL;
+#else
+    if (g_sys_fs_mapped[slot].data) {
+        if (g_sys_fs_mapped[slot].is_mmap) {
+            munmap((void*)g_sys_fs_mapped[slot].data, (size_t)g_sys_fs_mapped[slot].size);
+        } else {
+            free((void*)g_sys_fs_mapped[slot].data);
+        }
+    }
+#endif
+    g_sys_fs_mapped[slot].data = NULL;
+    g_sys_fs_mapped[slot].size = 0;
+    g_sys_fs_mapped[slot].pos = 0;
+    g_sys_fs_mapped[slot].is_mapped = 0;
+}
+
+static int sys_fs_try_map(int slot, const char* host_path)
+{
+    if (slot < 0 || slot >= SYS_FS_FD_MAX) return 0;
+    sys_fs_mapped_info* mf = &g_sys_fs_mapped[slot];
+    memset(mf, 0, sizeof(*mf));
+#ifdef _WIN32
+    mf->h_file = INVALID_HANDLE_VALUE;
+    HANDLE h = CreateFileA(host_path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, FILE_FLAG_SEQUENTIAL_SCAN, NULL);
+    if (h != INVALID_HANDLE_VALUE) {
+        LARGE_INTEGER sz;
+        if (GetFileSizeEx(h, &sz) && sz.QuadPart > 0) {
+            HANDLE hm = CreateFileMappingA(h, NULL, PAGE_READONLY, 0, 0, NULL);
+            if (hm) {
+                const uint8_t* p = (const uint8_t*)MapViewOfFile(hm, FILE_MAP_READ, 0, 0, 0);
+                if (p) {
+                    mf->h_file = h;
+                    mf->h_mapping = hm;
+                    mf->data = p;
+                    mf->size = (uint64_t)sz.QuadPart;
+                    mf->pos = 0;
+                    mf->is_mapped = 1;
+                    fprintf(stderr, "[sys_fs] fast-catalog mmap OK: slot=%d size=%llu MB ('%s')\n",
+                            slot, (unsigned long long)(sz.QuadPart / (1024 * 1024)), host_path);
+                    return 1;
+                }
+                CloseHandle(hm);
+            }
+        }
+        CloseHandle(h);
+    }
+    /* Fallback: heap buffer */
+    FILE* fp = fopen(host_path, "rb");
+    if (fp) {
+        _fseeki64(fp, 0, SEEK_END);
+        int64_t sz = _ftelli64(fp);
+        _fseeki64(fp, 0, SEEK_SET);
+        if (sz > 0) {
+            uint8_t* buf = (uint8_t*)malloc((size_t)sz);
+            if (buf && fread(buf, 1, (size_t)sz, fp) == (size_t)sz) {
