+/* Fast-path catalog mapping for infamous1.psarc_s */
+struct MappedFile {
+#ifdef _WIN32
+    HANDLE hFile;
+    HANDLE hMapping;
+#else
+    int is_mmap;
+#endif
+    const uint8_t* data;
+    uint64_t size;
+    uint64_t pos;
+    int is_mapped;
+};
+static MappedFile g_mapped_files[FS_MAX];
+
+static int is_fast_catalog_enabled(void)
+{
+    static int s_fast_catalog = -1;
+    if (s_fast_catalog < 0) {
+        const char* e1 = getenv("I2_FAST_CATALOG");
+        const char* e2 = getenv("I2_CATALOG_FASTPATH");
+        s_fast_catalog = ((e1 && atoi(e1) != 0) || (e2 && atoi(e2) != 0)) ? 1 : 0;
+    }
+    return s_fast_catalog;
+}
+
+static void unmap_file(int fd)
+{
+    if (fd < 0 || fd >= FS_MAX || !g_mapped_files[fd].is_mapped) return;
+#ifdef _WIN32
+    if (g_mapped_files[fd].data) {
+        if (g_mapped_files[fd].hMapping != NULL) {
+            UnmapViewOfFile(g_mapped_files[fd].data);
+        } else {
+            free((void*)g_mapped_files[fd].data);
+        }
+    }
+    if (g_mapped_files[fd].hMapping != NULL) {
+        CloseHandle(g_mapped_files[fd].hMapping);
+    }
+    if (g_mapped_files[fd].hFile != INVALID_HANDLE_VALUE && g_mapped_files[fd].hFile != NULL) {
+        CloseHandle(g_mapped_files[fd].hFile);
+    }
+    g_mapped_files[fd].hFile = INVALID_HANDLE_VALUE;
+    g_mapped_files[fd].hMapping = NULL;
+#else
+    if (g_mapped_files[fd].data) {
+        if (g_mapped_files[fd].is_mmap) {
+            munmap((void*)g_mapped_files[fd].data, (size_t)g_mapped_files[fd].size);
+        } else {
+            free((void*)g_mapped_files[fd].data);
+        }
+    }
+#endif
+    g_mapped_files[fd].data = nullptr;
+    g_mapped_files[fd].size = 0;
+    g_mapped_files[fd].pos = 0;
+    g_mapped_files[fd].is_mapped = 0;
+}
+
+static int try_map_file(int fd, const char* hpath)
+{
+    if (fd < 0 || fd >= FS_MAX) return 0;
+    MappedFile* mf = &g_mapped_files[fd];
+    memset(mf, 0, sizeof(*mf));
+#ifdef _WIN32
+    mf->hFile = INVALID_HANDLE_VALUE;
+    HANDLE h = CreateFileA(hpath, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, FILE_FLAG_SEQUENTIAL_SCAN, NULL);
+    if (h != INVALID_HANDLE_VALUE) {
+        LARGE_INTEGER sz;
+        if (GetFileSizeEx(h, &sz) && sz.QuadPart > 0) {
+            HANDLE hm = CreateFileMappingA(h, NULL, PAGE_READONLY, 0, 0, NULL);
+            if (hm) {
+                const uint8_t* p = (const uint8_t*)MapViewOfFile(hm, FILE_MAP_READ, 0, 0, 0);
+                if (p) {
+                    mf->hFile = h;
+                    mf->hMapping = hm;
+                    mf->data = p;
+                    mf->size = (uint64_t)sz.QuadPart;
+                    mf->pos = 0;
+                    mf->is_mapped = 1;
+                    fprintf(stderr, "[fs] fast-catalog mmap OK: fd=%d size=%llu MB ('%s')\n",
+                            fd, (unsigned long long)(sz.QuadPart / (1024 * 1024)), hpath);
+                    return 1;
+                }
+                CloseHandle(hm);
+            }
+        }
+        CloseHandle(h);
+    }
+    /* Fallback: heap buffer */
+    FILE* fp = fopen(hpath, "rb");
+    if (fp) {
+        fseek(fp, 0, SEEK_END);
+        long sz = ftell(fp);
+        fseek(fp, 0, SEEK_SET);
+        if (sz > 0) {
+            uint8_t* buf = (uint8_t*)malloc((size_t)sz);
+            if (buf && fread(buf, 1, (size_t)sz, fp) == (size_t)sz) {
+                mf->hFile = INVALID_HANDLE_VALUE;
+                mf->hMapping = NULL;
+                mf->data = buf;
+                mf->size = (uint64_t)sz;
+                mf->pos = 0;
+                mf->is_mapped = 1;
+                fprintf(stderr, "[fs] fast-catalog heap buffer OK: fd=%d size=%ld MB ('%s')\n",
+                        fd, sz / (1024 * 1024), hpath);
+                fclose(fp);
+                return 1;
+            }
+            if (buf) free(buf);
+        }
+        fclose(fp);
+    }
+#else
+    int fno = open(hpath, O_RDONLY);
+    if (fno >= 0) {
+        struct stat st;
+        if (fstat(fno, &st) == 0 && st.st_size > 0) {
+            void* p = mmap(NULL, (size_t)st.st_size, PROT_READ, MAP_SHARED, fno, 0);
+            if (p != MAP_FAILED) {
+                close(fno);
+                mf->is_mmap = 1;
+                mf->data = (const uint8_t*)p;
+                mf->size = (uint64_t)st.st_size;
+                mf->pos = 0;
+                mf->is_mapped = 1;
+                fprintf(stderr, "[fs] fast-catalog mmap OK: fd=%d size=%lld MB\n", fd, (long long)(st.st_size / (1024 * 1024)));
+                return 1;
+            }
+        }
+        close(fno);
+    }
+    FILE* fp = fopen(hpath, "rb");
+    if (fp) {
+        fseek(fp, 0, SEEK_END);
+        long sz = ftell(fp);
+        fseek(fp, 0, SEEK_SET);
+        if (sz > 0) {
+            uint8_t* buf = (uint8_t*)malloc((size_t)sz);
+            if (buf && fread(buf, 1, (size_t)sz, fp) == (size_t)sz) {
+                mf->data = buf;
+                mf->size = (uint64_t)sz;
+                mf->pos = 0;
+                mf->is_mapped = 1;
+                fclose(fp);
+                return 1;
+            }
+            if (buf) free(buf);
+        }
+        fclose(fp);
+    }
+#endif
+    return 0;
+}
